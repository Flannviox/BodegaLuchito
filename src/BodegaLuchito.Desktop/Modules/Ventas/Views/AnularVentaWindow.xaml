<Window x:Class="BodegaLuchito.Desktop.Modules.Ventas.Views.AnularVentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anular Venta" Height="250" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Anular Venta" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Motivo de la anulación (Obligatorio):" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtMotivo" TextWrapping="Wrap" AcceptsReturn="True" Height="70" 
                     Padding="8" BorderBrush="#CBD5E1" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Click="BtnCancelar_Click" Width="100" Height="35" 
                    Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>
            <Button Content="Confirmar" Click="BtnConfirmar_Click" Width="100" Height="35" 
                    Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="BodegaLuchito.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- MENÚ LATERAL -->

        <Border Grid.Column="0"
                BorderBrush="LightGray"
                BorderThickness="0,0,1,0">

            <StackPanel Margin="16">

                <TextBlock Text="Bodega Luchito"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,10,0,30" />

                <Button Content="Inicio"
                        Command="{Binding IrAInicioCommand}"
                        Height="42"
                        Margin="0,0,0,10" />

                <Button Content="Productos"
                        Command="{Binding IrAProductosCommand}"
                        Height="42"
                        Margin="0,0,0,10" />

                <Button Content="Ventas"
                        Command="{Binding IrAVentasCommand}"
                        Height="42"
                        Margin="0,0,0,10" />

            </StackPanel>

        </Border>


        <!-- CONTENIDO -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="LightGray"
                    BorderThickness="0,0,0,1"
                    Padding="24,18">

                <TextBlock Text="{Binding Titulo}"
                           FontSize="20"
                           FontWeight="SemiBold" />

            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            Margin="30" />

        </Grid>

    </Grid>

</Window>

<Window x:Class="BodegaLuchito.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="220" />

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>


        <!-- MENU LATERAL -->

        <Border Grid.Column="0"
                BorderBrush="LightGray"
                BorderThickness="0,0,1,0">

            <Grid Margin="16">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />

                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>


                <!-- TITULO -->

                <TextBlock Grid.Row="0"
                           Text="Bodega Luchito"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,10,0,30" />


                <!-- MENU -->

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding MenuItems}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button Content="{Binding Titulo}"
                                    Command="{Binding Command}"
                                    Height="42"
                                    Margin="0,0,0,10" />

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>


                <!-- CERRAR SESION -->

                <Button Grid.Row="2"
                        Content="Cerrar sesion"
                        Command="{Binding CerrarSesionCommand}"
                        Height="42"
                        Margin="0,15,0,0" />

            </Grid>

        </Border>


        <!-- CONTENIDO -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto" />

                <RowDefinition Height="*" />

            </Grid.RowDefinitions>


            <!-- HEADER -->

            <Border Grid.Row="0"
                    BorderBrush="LightGray"
                    BorderThickness="0,0,0,1"
                    Padding="24,16">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="{Binding Titulo}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />


                    <StackPanel Grid.Column="1">

                        <TextBlock Text="{Binding NombreUsuario}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />

                        <TextBlock Text="{Binding NombreRol}"
                                   FontSize="12"
                                   HorizontalAlignment="Right" />

                    </StackPanel>

                </Grid>

            </Border>


            <!-- MODULO ACTUAL -->

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            Margin="30" />

        </Grid>

    </Grid>

</Window>

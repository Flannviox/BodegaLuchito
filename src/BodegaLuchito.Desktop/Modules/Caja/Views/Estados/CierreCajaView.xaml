<UserControl x:Class="BodegaLuchito.Desktop.Modules.Caja.Views.Estados.CierreCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controles="clr-namespace:BodegaLuchito.Desktop.Modules.Caja.Views.Controles"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="580">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="../../Resources/CajaStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="0.7*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource Tarjeta}">

            <StackPanel>
                <TextBlock Text="Cierre de caja"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTextoPrincipal}" />
                <TextBlock
                    Text="Registra los montos totales que verificas al finalizar la jornada."
                    FontSize="13"
                    Foreground="{StaticResource ColorTextoSecundario}"
                    Margin="0,6,0,22" />

                <Border Background="{StaticResource ColorAcentoClaro}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,22">

                    <TextBlock
                        Text=" Importante: Debe registrar el total disponible al cierre, no únicamente las ventas realizadas durante la jornada. Elefectivo debe incluir tambien el fondo inicial"
                        FontSize="12"
                        Foreground="{StaticResource ColorAcento}"
                        TextWrapping="Wrap"

                        />


                </Border>
                <TextBlock Text="Verificacion final"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTextoPrincipal}"
                           Margin="0,0,0,14" />
                <controles:CampoEntrada
                    Etiqueta="Efectivo total contado en caja"
                    Valor="{Binding EfectivoRealInput}" />

                <controles:CampoEntrada
                    Etiqueta="Total verificado en Yape"
                    Valor="{Binding YapeRealInput}" />

                <controles:CampoEntrada
                    Etiqueta="Total verificado en Plin"
                    Valor="{Binding PlinRealInput}" />

                <TextBlock Text="Observación del cierre (opcional)"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTextoPrincipal}"
                           Margin="0,2,0,7" />

                <TextBox Text="{Binding ObservacionInput,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CajaTextBox}"
                         MinHeight="85"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top" />

                <TextBlock
                    Text="Puedes registrar alguna incidencia ocurrida durante la jornada."
                    FontSize="12"
                    Foreground="{StaticResource ColorTextoSecundario}"
                    Margin="2,7,0,22" />

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Volver"
                            Command="{Binding CancelarCierreCommand}"
                            Style="{StaticResource BotonSecundario}" />
                    <Button Grid.Column="2"
                            Content="Confirmar cierre"
                            Command="{Binding CerrarCajaCommand}"
                            Style="{StaticResource BotonPrimario}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource Tarjeta}">

            <StackPanel>
                <TextBlock Text="Sesión actual"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTextoPrincipal}"
                           Margin="0,0,0,22" />

                <TextBlock Text="Apertura"
                           FontSize="12"
                           Foreground="{StaticResource ColorTextoSecundario}" />

                <TextBlock Text="{Binding FechaApertura,
                                         StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTextoPrincipal}"
                           Margin="0,4,0,20" />

                <TextBlock Text="Fondo inicial"
                           FontSize="12"
                           Foreground="{StaticResource ColorTextoSecundario}" />

                <TextBlock Text="{Binding FondoInicialActual,
                                         StringFormat=S/ \{0:N2\}}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTextoPrincipal}"
                           Margin="0,4,0,20" />

                <TextBlock Text="Estado"
                           FontSize="12"
                           Foreground="{StaticResource ColorTextoSecundario}" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,6,0,24">

                    <Ellipse Width="8"
                             Height="8"
                             Fill="{StaticResource ColorExito}"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0" />

                    <TextBlock Text="Caja abierta"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorExito}" />
                </StackPanel>

                <Border Background="{StaticResource ColorAdvertenciaClaro}"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="¿Qué ocurrirá al cerrar?"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorAdvertencia}"
                                   Margin="0,0,0,5" />
                        <TextBlock
                            Text="El sistema comparará los montos calculados según el fondo inicial y los movimientos de la sesión con los montos verificados al cierre."
                            FontSize="12"
                            Foreground="{StaticResource ColorAdvertencia}"
                            TextWrapping="Wrap" />

                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

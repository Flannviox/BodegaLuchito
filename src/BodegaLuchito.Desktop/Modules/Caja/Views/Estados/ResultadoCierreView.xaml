<UserControl x:Class="BodegaLuchito.Desktop.Modules.Caja.Views.Estados.ResultadoCierreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="560">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="../../Resources/CajaStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <Border Background="{StaticResource ColorExitoClaro}"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="42"
                        Height="42"
                        CornerRadius="21"
                        Background="White"
                        Margin="0,0,14,0">

                    <TextBlock Text="✓"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorExito}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock
                        Text="La sesión fue cerrada correctamente."
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ColorExito}" />

                    <TextBlock
                        Text="Revisa la conciliación del efectivo y el resumen de los movimientos digitales de la jornada."
                        FontSize="12"
                        Foreground="{StaticResource ColorTextoSecundario}"
                        Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>


        <Border Style="{StaticResource Tarjeta}">

            <StackPanel>

                <TextBlock Text="Resumen del cierre"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTextoPrincipal}" />

                <TextBlock
                    Text="El efectivo se compara con el monto contado físicamente. Yape y Plin muestran los movimientos registrados automáticamente durante la sesión."
                    FontSize="13"
                    Foreground="{StaticResource ColorTextoSecundario}"
                    TextWrapping="Wrap"
                    Margin="0,6,0,24" />


                <TextBlock Text="Conciliación de efectivo"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTextoPrincipal}"
                           Margin="0,0,0,4" />

                <TextBlock
                    Text="Comparación entre el efectivo calculado por el sistema y el efectivo contado al cierre."
                    FontSize="12"
                    Foreground="{StaticResource ColorTextoSecundario}"
                    Margin="0,0,0,16" />


                <Grid Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="MEDIO DE PAGO"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoSecundario}" />

                    <TextBlock Grid.Column="1"
                               Text="SEGÚN SISTEMA"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoSecundario}" />

                    <TextBlock Grid.Column="2"
                               Text="CONTADO"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoSecundario}" />

                    <TextBlock Grid.Column="3"
                               Text="DIFERENCIA"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoSecundario}" />

                </Grid>

                <Separator Background="{StaticResource ColorBorde}" />


                <Grid Margin="0,16,0,22">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Efectivo"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoPrincipal}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ResultadoUltimoCierre.EfectivoEsperado,
                                              StringFormat=S/ \{0:N2\}}"
                               FontSize="14"
                               Foreground="{StaticResource ColorTextoPrincipal}" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding ResultadoUltimoCierre.EfectivoReal,
                                              StringFormat=S/ \{0:N2\}}"
                               FontSize="14"
                               Foreground="{StaticResource ColorTextoPrincipal}" />

                    <TextBlock Grid.Column="3"
                               Text="{Binding ResultadoUltimoCierre.DiferenciaEfectivo,
                                              StringFormat=S/ \{0:N2\}}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoPrincipal}" />

                </Grid>

                <TextBlock Text="Movimientos digitales"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTextoPrincipal}"
                           Margin="0,4,0,4" />

                <TextBlock
                    Text="Resumen de los ingresos y salidas registrados por Yape y Plin durante la sesión."
                    FontSize="12"
                    Foreground="{StaticResource ColorTextoSecundario}"
                    Margin="0,0,0,16" />

                <Grid Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="MEDIO DE PAGO"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoSecundario}" />

                    <TextBlock Grid.Column="1"
                               Text="INGRESOS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoSecundario}" />

                    <TextBlock Grid.Column="2"
                               Text="SALIDAS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoSecundario}" />

                    <TextBlock Grid.Column="3"
                               Text="NETO"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoSecundario}" />

                </Grid>

                <Separator Background="{StaticResource ColorBorde}" />

                <Grid Margin="0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Yape"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoPrincipal}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ResultadoUltimoCierre.YapeIngresos,
                                              StringFormat=S/ \{0:N2\}}"
                               FontSize="14"
                               Foreground="{StaticResource ColorTextoPrincipal}" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding ResultadoUltimoCierre.YapeSalidas,
                                              StringFormat=S/ \{0:N2\}}"
                               FontSize="14"
                               Foreground="{StaticResource ColorTextoPrincipal}" />

                    <TextBlock Grid.Column="3"
                               Text="{Binding ResultadoUltimoCierre.YapeNeto,
                                              StringFormat=S/ \{0:N2\}}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoPrincipal}" />

                </Grid>

                <Separator Background="{StaticResource ColorBorde}" />

                <Grid Margin="0,16,0,24">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Plin"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoPrincipal}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ResultadoUltimoCierre.PlinIngresos,
                                              StringFormat=S/ \{0:N2\}}"
                               FontSize="14"
                               Foreground="{StaticResource ColorTextoPrincipal}" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding ResultadoUltimoCierre.PlinSalidas,
                                              StringFormat=S/ \{0:N2\}}"
                               FontSize="14"
                               Foreground="{StaticResource ColorTextoPrincipal}" />

                    <TextBlock Grid.Column="3"
                               Text="{Binding ResultadoUltimoCierre.PlinNeto,
                                              StringFormat=S/ \{0:N2\}}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoPrincipal}" />

                </Grid>


                <Button Content="Iniciar nueva jornada"
                        Command="{Binding NuevaAperturaCommand}"
                        Style="{StaticResource BotonPrimario}"
                        Width="200"
                        HorizontalAlignment="Right" />

            </StackPanel>
        </Border>

    </StackPanel>

</UserControl>

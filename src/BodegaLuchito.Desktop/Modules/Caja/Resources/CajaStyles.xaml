<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ColorFondo"
                     Color="#F4F6F8" />

    <SolidColorBrush x:Key="ColorTarjeta"
                     Color="#FFFFFF" />

    <SolidColorBrush x:Key="ColorBorde"
                     Color="#E3E7EC" />

    <SolidColorBrush x:Key="ColorTextoPrincipal"
                     Color="#0D2B4E" />

    <SolidColorBrush x:Key="ColorTextoSecundario"
                     Color="#5D6B7A" />

    <SolidColorBrush x:Key="ColorAcento"
                     Color="#1668C1" />

    <SolidColorBrush x:Key="ColorAcentoHover"
                     Color="#12569F" />

    <SolidColorBrush x:Key="ColorAcentoClaro"
                     Color="#E7F0FA" />

    <SolidColorBrush x:Key="ColorExito"
                     Color="#229954" />

    <SolidColorBrush x:Key="ColorExitoClaro"
                     Color="#EAF7EF" />

    <SolidColorBrush x:Key="ColorAdvertencia"
                     Color="#D68910" />

    <SolidColorBrush x:Key="ColorAdvertenciaClaro"
                     Color="#FFF5E5" />

    <SolidColorBrush x:Key="ColorError"
                     Color="#C0392B" />

    <SolidColorBrush x:Key="ColorErrorFondo"
                     Color="#FCEBEB" />

    <Style x:Key="Tarjeta"
           TargetType="Border">

        <Setter Property="Background"
                Value="{StaticResource ColorTarjeta}" />

        <Setter Property="BorderBrush"
                Value="{StaticResource ColorBorde}" />

        <Setter Property="BorderThickness"
                Value="1" />

        <Setter Property="CornerRadius"
                Value="12" />

        <Setter Property="Padding"
                Value="24" />

        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="1"
                                  Opacity="0.06" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonPrimario"
           TargetType="Button">

        <Setter Property="Background"
                Value="{StaticResource ColorAcento}" />

        <Setter Property="Foreground"
                Value="White" />

        <Setter Property="FontSize"
                Value="14" />

        <Setter Property="FontWeight"
                Value="SemiBold" />

        <Setter Property="Padding"
                Value="20,11" />

        <Setter Property="MinHeight"
                Value="42" />

        <Setter Property="Cursor"
                Value="Hand" />

        <Setter Property="BorderThickness"
                Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="Borde"
                                    Property="Background"
                                    Value="{StaticResource ColorAcentoHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonSecundario"
           TargetType="Button"
           BasedOn="{StaticResource BotonPrimario}">

        <Setter Property="Background"
                Value="White" />

        <Setter Property="Foreground"
                Value="{StaticResource ColorAcento}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource ColorAcento}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="Borde"
                                    Property="Background"
                                    Value="{StaticResource ColorAcentoClaro}" />

                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CajaTextBox"
       TargetType="TextBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextoPrincipal}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,10" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borde"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused"
                             Value="True">

                            <Setter TargetName="Borde"
                                Property="BorderBrush"
                                Value="{StaticResource ColorAcento}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

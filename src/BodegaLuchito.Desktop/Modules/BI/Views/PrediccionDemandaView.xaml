<UserControl x:Class="BodegaLuchito.Desktop.Modules.BI.Views.PrediccionDemandaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Unloaded="AlSalir" Background="#F4F7FB" Foreground="#17365D" FontSize="14" Language="es-PE">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <FontFamily x:Key="FuenteIconos">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Botón principal -->
        <Style x:Key="BotonPrincipal" TargetType="Button">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="26,8"/>
            <Setter Property="Background" Value="#1467DC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Marco" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="#1467DC" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="#0F56BA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Marco" Property="BorderBrush" Value="#0B2443"/>
                                <Setter TargetName="Marco" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="#0B4596"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonPrincipal}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1467DC"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style TargetType="DatePicker">
            <Style.Resources>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4"/>
                </Style>
            </Style.Resources>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE6F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#456385"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Semáforo: Alto = rojo, Medio = ámbar, Bajo = verde, Neutro = gris azulado -->
        <Style x:Key="FondoSuave" TargetType="Border">
            <Setter Property="Background" Value="#EEF2F7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Nivel}" Value="Alto"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="Medio"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="Bajo"><Setter Property="Background" Value="#DCFCE7"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextoNivel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Nivel}" Value="Alto"><Setter Property="Foreground" Value="#B91C1C"/></DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="Medio"><Setter Property="Foreground" Value="#92400E"/></DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="Bajo"><Setter Property="Foreground" Value="#166534"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FranjaNivel" TargetType="Border">
            <Setter Property="Background" Value="#94A3B8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Nivel}" Value="Alto"><Setter Property="Background" Value="#DC2626"/></DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="Medio"><Setter Property="Background" Value="#F59E0B"/></DataTrigger>
                <DataTrigger Binding="{Binding Nivel}" Value="Bajo"><Setter Property="Background" Value="#16A34A"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Filas de la lista: resaltado suave al pasar el mouse y al seleccionar -->
        <Style x:Key="FilaProducto" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Fila" Background="White" BorderBrush="#E5EDF7" BorderThickness="0,0,0,1">
                            <Grid>
                                <Border x:Name="Marca" Width="4" HorizontalAlignment="Left" Background="Transparent"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fila" Property="Background" Value="#F5F9FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fila" Property="Background" Value="#E8F1FE"/>
                                <Setter TargetName="Marca" Property="Background" Value="#1467DC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Encabezado" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#456385"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="8,12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Celda" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,12">

            <!-- 1. Encabezado y controles -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="¿Cuánto venderás la próxima semana?" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,14" Foreground="#456385" FontSize="15"
                        Text="Mira lo que vendiste en una semana y cuánto podrías vender la siguiente. Así sabes qué comprar a tiempo."/>

                    <Border Background="#FFF7E6" CornerRadius="8" Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding EsEjemplo, Converter={StaticResource Visible}}">
                        <TextBlock TextWrapping="Wrap" Foreground="#7C4A03" FontWeight="SemiBold"
                            Text="Estás viendo un EJEMPLO con productos inventados. Tus ventas y tu stock no cambian."/>
                    </Border>

                    <WrapPanel IsEnabled="{Binding Disponible}">
                        <StackPanel Width="170" Margin="0,0,14,10">
                            <TextBlock Text="¿Qué quieres ver?" Style="{StaticResource Etiqueta}"/>
                            <ComboBox ItemsSource="{Binding Fuentes}" SelectedItem="{Binding Fuente}"/>
                        </StackPanel>
                        <StackPanel Width="280" Margin="0,0,14,10" Visibility="{Binding EsNegocio, Converter={StaticResource Visible}}">
                            <TextBlock Text="Semana que quieres revisar" Style="{StaticResource Etiqueta}"/>
                            <ComboBox ItemsSource="{Binding Semanas}" SelectedItem="{Binding Semana}"/>
                        </StackPanel>
                        <Button Style="{StaticResource BotonPrincipal}" Command="{Binding AnalizarCommand}"
                                VerticalAlignment="Bottom" Margin="0,0,14,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource FuenteIconos}" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Revisar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <StackPanel Visibility="{Binding EsNegocio, Converter={StaticResource Visible}}" IsEnabled="{Binding Disponible}">
                        <CheckBox IsChecked="{Binding HistorialCompleto}" VerticalContentAlignment="Center" Margin="0,4,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="14" Margin="4,0,0,0"
                                Text="Registré en el sistema todas mis ventas (si un día no aparece nada, es porque no vendí)."/>
                        </CheckBox>
                        <Expander Header="Más opciones" Margin="0,10,0,0" Foreground="#456385">
                            <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
                                <TextBlock Text="Registro mis ventas en el sistema desde:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <DatePicker Width="160" SelectedDate="{Binding Desde}"
                                    DisplayDateStart="{Binding FechaMinima, Mode=OneWay}"
                                    DisplayDateEnd="{Binding FechaMaxima, Mode=OneWay}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Estado de la revisión -->
            <Grid Margin="4,0,4,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Periodo}" TextWrapping="Wrap" Foreground="#1467DC" FontWeight="SemiBold" FontSize="15"
                        Visibility="{Binding AnalisisRealizado, Converter={StaticResource Visible}}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontSize="15"/>
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,8,0,0" Foreground="#1467DC" Background="#DBEAFE"
                        BorderThickness="0" Visibility="{Binding Ocupado, Converter={StaticResource Visible}}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource BotonSecundario}" Content="Cancelar" Command="{Binding CancelarCommand}"
                    VerticalAlignment="Top" Margin="12,0,0,0" Visibility="{Binding Ocupado, Converter={StaticResource Visible}}"/>
            </Grid>

            <!-- 3. Bienvenida: cómo leer los colores -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,14" Visibility="{Binding MostrarBienvenida, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="Cómo leer los resultados" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,8">
                            <Border Width="16" Height="16" CornerRadius="8" Background="#DC2626" Margin="0,0,8,0"/>
                            <TextBlock><Run Text="Rojo:" FontWeight="SemiBold"/><Run Text=" podría faltar, compra pronto"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,8">
                            <Border Width="16" Height="16" CornerRadius="8" Background="#F59E0B" Margin="0,0,8,0"/>
                            <TextBlock><Run Text="Amarillo:" FontWeight="SemiBold"/><Run Text=" alcanza justo"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,8">
                            <Border Width="16" Height="16" CornerRadius="8" Background="#16A34A" Margin="0,0,8,0"/>
                            <TextBlock><Run Text="Verde:" FontWeight="SemiBold"/><Run Text=" tienes suficiente"/></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,28,8">
                            <Border Width="16" Height="16" CornerRadius="8" Background="#94A3B8" Margin="0,0,8,0"/>
                            <TextBlock><Run Text="Gris:" FontWeight="SemiBold"/><Run Text=" todavía no se puede calcular"/></TextBlock>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#456385" Margin="0,6,0,0"
                        Text="Solo aparecen los productos que se vendieron en la semana elegida. Los que necesitan atención aparecen primero. Toca un producto para ver qué hacer."/>
                </StackPanel>
            </Border>

            <!-- 4. Resumen en números grandes -->
            <ItemsControl ItemsSource="{Binding Indicadores}" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FondoSuave}" CornerRadius="12" Padding="18,12" Margin="0,0,12,12" MinWidth="150">
                            <StackPanel>
                                <TextBlock Text="{Binding Valor}" FontSize="30" FontWeight="Bold" Style="{StaticResource TextoNivel}"/>
                                <TextBlock Text="{Binding Texto}" FontSize="14" Style="{StaticResource TextoNivel}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 5. Lista de productos (una fila por producto) -->
            <Border Style="{StaticResource Tarjeta}" Padding="0" Visibility="{Binding TieneResultados, Converter={StaticResource Visible}}">
                <StackPanel>
                    <Grid Background="#EFF5FC" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Producto" Style="{StaticResource Encabezado}" Margin="44,12,8,12"/>
                        <TextBlock Grid.Column="1" Text="Vendiste" Style="{StaticResource Encabezado}"/>
                        <TextBlock Grid.Column="2" Text="Venderías" Style="{StaticResource Encabezado}"/>
                        <TextBlock Grid.Column="3" Text="Cambio" Style="{StaticResource Encabezado}"/>
                        <TextBlock Grid.Column="4" Text="{Binding TituloApoyo}" Style="{StaticResource Encabezado}"/>
                        <TextBlock Grid.Column="5" Text="¿Cómo está?" Style="{StaticResource Encabezado}"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding Resultados}" SelectedItem="{Binding Seleccionado}"
                             ItemContainerStyle="{StaticResource FilaProducto}" Background="Transparent" BorderThickness="0">
                        <ListBox.Template>
                            <!-- Sin barra propia: la página completa es la que se desplaza. -->
                            <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,8,8,8">
                                        <Border Width="14" Height="14" CornerRadius="7" Style="{StaticResource FranjaNivel}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding Producto}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Vendido}" Style="{StaticResource Celda}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Estimado}" Style="{StaticResource Celda}"
                                               FontWeight="Bold" Foreground="#1467DC"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Tendencia}" Style="{StaticResource Celda}" Foreground="#1E4F8C"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Apoyo}" Style="{StaticResource Celda}"/>
                                    <Border Grid.Column="5" Style="{StaticResource FondoSuave}" CornerRadius="14" Padding="10,5"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource FuenteIconos}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource TextoNivel}"/>
                                            <TextBlock Text="{Binding Etiqueta}" FontWeight="SemiBold" FontSize="13"
                                                       VerticalAlignment="Center" Style="{StaticResource TextoNivel}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 6. Lo que hay que saber del producto elegido -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,14,0,0"
                    Visibility="{Binding HaySeleccion, Converter={StaticResource Visible}}">
                <StackPanel DataContext="{Binding Seleccionado}">
                    <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap">
                        <Run Text="{Binding Producto, Mode=OneWay}"/>
                    </TextBlock>
                    <Border Style="{StaticResource FondoSuave}" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource FuenteIconos}" FontSize="18"
                                       VerticalAlignment="Top" Margin="0,1,12,0" Style="{StaticResource TextoNivel}"/>
                            <TextBlock Text="{Binding Consejo}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"
                                       MaxWidth="900" Style="{StaticResource TextoNivel}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="¿De dónde sale este número?" FontWeight="SemiBold" FontSize="15" Margin="0,14,0,4"/>
                    <TextBlock Text="{Binding ExplicacionSencilla}" TextWrapping="Wrap" FontSize="14" Foreground="#334155"/>
                    <TextBlock Text="{Binding TextoConfianza}" TextWrapping="Wrap" FontSize="14" Foreground="#334155" Margin="0,8,0,0"
                               Visibility="{Binding TieneConfianza, Converter={StaticResource Visible}}"/>
                </StackPanel>
            </Border>

            <!-- 7. Aviso final -->
            <StackPanel Margin="4,12,4,0" Visibility="{Binding AnalisisRealizado, Converter={StaticResource Visible}}">
                <TextBlock TextWrapping="Wrap" Foreground="#456385"
                    Text="Estas cifras son aproximadas y solo sirven para planificar. Esta pantalla no compra nada ni cambia tu stock."/>
                <TextBlock Text="{Binding FechaCalculo}" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

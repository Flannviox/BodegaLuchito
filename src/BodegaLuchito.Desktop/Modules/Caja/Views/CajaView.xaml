<UserControl x:Class="BodegaLuchito.Desktop.Modules.Caja.Views.CajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:estados="clr-namespace:BodegaLuchito.Desktop.Modules.Caja.Views.Estados"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="700">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="../Resources/CajaStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter
                x:Key="BoolAVisibilidad" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource ColorFondo}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,26,32,36"
                  HorizontalAlignment="Stretch">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="MaxWidth"
                                Value="1180" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrarHistorial}"
                                         Value="True">
                                <Setter Property="MaxWidth"
                                        Value="1380" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Caja"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTextoPrincipal}" />
                        <TextBlock
                            Text="Control de apertura, operación y cierre de caja."
                            FontSize="14"
                            Foreground="{StaticResource ColorTextoSecundario}"
                            Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">

                        <Button Content="Historial de cierres"
                                Command="{Binding AbrirHistorialCommand}"
                                Margin="0,0,12,0"
                                Width ="140"
                                Height="44">

                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource BotonSecundario}">

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MostrarHistorial}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>

                                </Style>
                            </Button.Style>

                        </Button>

                        <Border Background="{StaticResource ColorExitoClaro}"
                                CornerRadius="18"
                                Padding="13,7"
                                VerticalAlignment="Top"
                                Visibility="{Binding CajaAbierta,
                         Converter={StaticResource BoolAVisibilidad}}">

                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{StaticResource ColorExito}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0" />

                                <TextBlock Text="Caja abierta"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorExito}" />
                            </StackPanel>

                        </Border>

                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Background="{StaticResource ColorErrorFondo}"
                        BorderBrush="{StaticResource ColorError}"
                        BorderThickness="4,0,0,0"
                        CornerRadius="6"
                        Padding="14,10"
                        Margin="0,0,0,20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensajeError}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock
                            Text="No se pudo completar la operación"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ColorError}"
                            Margin="0,0,0,3" />
                        <TextBlock Text="{Binding MensajeError}"
                                   FontSize="13"
                                   Foreground="{StaticResource ColorError}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <estados:AperturaCajaView
                        Visibility="{Binding MostrarApertura,
                            Converter={StaticResource BoolAVisibilidad}}" />

                    <estados:CajaEnOperacionView
                        Visibility="{Binding MostrarResumen,
                            Converter={StaticResource BoolAVisibilidad}}" />

                    <estados:CierreCajaView
                        Visibility="{Binding MostrarFormularioCierre,
                            Converter={StaticResource BoolAVisibilidad}}" />

                    <estados:ResultadoCierreView
                        Visibility="{Binding MostrarResultadoCierre,
                            Converter={StaticResource BoolAVisibilidad}}" />
                    <estados:HistorialCierresView
                        Visibility="{Binding MostrarHistorial,
                        Converter= {StaticResource BoolAVisibilidad}}"  />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>

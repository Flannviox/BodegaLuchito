<UserControl x:Class="BodegaLuchito.Desktop.Modules.Proveedores.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20"> 
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Formulario  -->
        <Border Grid.Column="0" Background="White" Padding="20" Margin="0,0,20,0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Nuevo Proveedor" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <TextBlock Text="Nombre *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="RUC (11 dígitos opcional)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Ruc, UpdateSourceTrigger=PropertyChanged}" MaxLength="11" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Teléfono" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Dirección" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,20"/>

                <Button Content="Registrar" Command="{Binding RegistrarCommand}" 
                        Background="#2b5797" Foreground="White" Padding="10" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Lista -->
        <Border Grid.Column="1" Background="White" Padding="20" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Proveedores Activos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>
                <DataGrid ItemsSource="{Binding ListaProveedores}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="White" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="RUC" Binding="{Binding Ruc}" Width="100"/>
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="100"/>
                        <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="VentaTarjeta" TargetType="Border">
        <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFE7F2"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="VentaBoton" TargetType="Button">
        <Setter Property="Background" Value="#1767D8"/><Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#1767D8"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="38"/>
        <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Marco" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Marco" Property="BorderBrush" Value="#68B2FF"/><Setter TargetName="Marco" Property="BorderThickness" Value="2"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1C5799"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#123D70"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#E8EDF4"/><Setter Property="BorderBrush" Value="#D8E2EE"/><Setter Property="Foreground" Value="#617187"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="VentaSecundario" TargetType="Button" BasedOn="{StaticResource VentaBoton}">
        <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#234264"/><Setter Property="BorderBrush" Value="#D8E2EE"/>
    </Style>
    <Style x:Key="VentaPeligro" TargetType="Button" BasedOn="{StaticResource VentaSecundario}">
        <Setter Property="Foreground" Value="#B42318"/><Setter Property="BorderBrush" Value="#F3D3CF"/><Setter Property="Background" Value="#FFF7F6"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B42318"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="VentaEntrada" TargetType="TextBox">
        <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#17365D"/>
        <Setter Property="BorderBrush" Value="#CAD8E9"/><Setter Property="Background" Value="White"/>
    </Style>
    <Style x:Key="VentaTextoCelda" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="VentaTabla" TargetType="DataGrid">
        <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17365D"/>
        <Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFD"/><Setter Property="HorizontalGridLinesBrush" Value="#E8EEF6"/>
        <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="IsReadOnly" Value="True"/><Setter Property="MinRowHeight" Value="58"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value><Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#EFF5FC"/><Setter Property="Foreground" Value="#456385"/>
                <Setter Property="Padding" Value="10,12"/><Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style></Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value><Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/>
                <Setter Property="Foreground" Value="#17365D"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border>
                </ControlTemplate></Setter.Value></Setter>
                <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DFECFF"/><Setter Property="Foreground" Value="#123968"/></Trigger></Style.Triggers>
            </Style></Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value><Style TargetType="DataGridRow"><Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EFF6FF"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DFECFF"/><Setter Property="Foreground" Value="#123968"/></Trigger>
            </Style.Triggers></Style></Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

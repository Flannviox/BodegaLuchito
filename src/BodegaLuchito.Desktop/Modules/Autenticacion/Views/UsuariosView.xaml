<UserControl x:Class="BodegaLuchito.Desktop.Modules.Autenticacion.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UsuariosView_OnLoaded">

    <UserControl.Resources>

        <BooleanToVisibilityConverter
            x:Key="BoolToVisibility" />
        <Style x:Key="FormTextBoxStyle"
       TargetType="TextBox">

            <Setter Property="Height"
            Value="44" />

            <Setter Property="Padding"
            Value="12,0" />

            <Setter Property="VerticalContentAlignment"
            Value="Center" />

            <Setter Property="FontSize"
            Value="14" />

            <Setter Property="Background"
            Value="White" />

            <Setter Property="BorderBrush"
            Value="#CBD5E1" />

            <Setter Property="BorderThickness"
            Value="1" />

        </Style>

        <Style x:Key="FormPasswordBoxStyle"
       TargetType="PasswordBox">

            <Setter Property="Height"
            Value="44" />

            <Setter Property="Padding"
            Value="12,0" />

            <Setter Property="VerticalContentAlignment"
            Value="Center" />

            <Setter Property="FontSize"
            Value="14" />

            <Setter Property="Background"
            Value="White" />

            <Setter Property="BorderBrush"
            Value="#CBD5E1" />

            <Setter Property="BorderThickness"
            Value="1" />

        </Style>

        <Style x:Key="FormComboBoxStyle"
       TargetType="ComboBox">

            <Setter Property="Height"
            Value="44" />

            <Setter Property="Padding"
            Value="10,0" />

            <Setter Property="VerticalContentAlignment"
            Value="Center" />

            <Setter Property="FontSize"
            Value="14" />

            <Setter Property="Background"
            Value="White" />

            <Setter Property="BorderBrush"
            Value="#CBD5E1" />

            <Setter Property="BorderThickness"
            Value="1" />

        </Style>

        <Style TargetType="ComboBoxItem">

            <Setter Property="MinHeight"
            Value="38" />

            <Setter Property="Padding"
            Value="10,6" />

            <Setter Property="VerticalContentAlignment"
            Value="Center" />

        </Style>
        <Style x:Key="SecondaryButtonStyle"
       TargetType="Button">

            <Setter Property="Height"
            Value="40" />

            <Setter Property="Padding"
            Value="18,0" />

            <Setter Property="Background"
            Value="White" />

            <Setter Property="Foreground"
            Value="#334155" />

            <Setter Property="BorderBrush"
            Value="#CBD5E1" />

            <Setter Property="BorderThickness"
            Value="1" />

            <Setter Property="FontWeight"
            Value="SemiBold" />

            <Setter Property="Cursor"
            Value="Hand" />

        </Style>
        <Style x:Key="DataGridTextCellStyle"
            TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
            Value="Center" />

            <Setter Property="Margin"
            Value="6,0" />

        </Style>

    </UserControl.Resources>

    <Grid Background="#F8FAFC">

        <!-- Contenido principal -->

        <Grid Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->

            <Grid>

                <StackPanel>

                    <TextBlock Text="Gestión de usuarios"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#17365D" />

                    <TextBlock Text="Administra las cuentas y permisos del sistema."
                               Margin="0,6,0,0"
                               FontSize="14"
                               Foreground="#64748B" />

                </StackPanel>

                <Button Content="+ Nuevo usuario"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Height="42"
                        Padding="20,0"
                        Command="{Binding NuevoUsuarioCommand}"
                        Background="#0866E5"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold" />

            </Grid>

            <!-- Mensajes -->

            <StackPanel Grid.Row="1"
                        Margin="0,18,0,0">

                <TextBlock Text="{Binding MensajeError}"
                           Foreground="#C62828"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />

            </StackPanel>

            <!-- Herramientas -->

            <Grid Grid.Row="2"
                  Margin="0,18,0,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="420"
      Height="44"
      HorizontalAlignment="Left">

                    <TextBox x:Name="BuscarUsuarioTextBox"
             Padding="14,0"
             VerticalContentAlignment="Center"
             FontSize="14"
             Background="White"
             BorderBrush="#CBD5E1"
             BorderThickness="1"
             Text="{Binding TextoBusqueda,
                            UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Buscar por nombre, usuario o rol..."
               Margin="15,0,0,0"
               VerticalAlignment="Center"
               Foreground="#94A3B8"
               FontSize="14"
               IsHitTestVisible="False">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                        Value="Collapsed" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length,
                                                   ElementName=BuscarUsuarioTextBox}"
                                 Value="0">
                                        <Setter Property="Visibility"
                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button Content="Editar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    Command="{Binding EditarUsuarioCommand}" />

                    <Button Content="{Binding TextoCambiarEstado}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    Command="{Binding CambiarEstadoUsuarioCommand}" />

                    <Button Content="Cambiar contraseña"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding AbrirRestablecerPasswordCommand}" />

                </StackPanel>

            </Grid>

            <!-- Tabla -->

            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10">

                <DataGrid ItemsSource="{Binding Usuarios}"
                      SelectedItem="{Binding UsuarioSeleccionado}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      RowHeight="46"
                      ColumnHeaderHeight="44">

                    <!-- Centrar verticalmente encabezados -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
                            <Setter Property="Padding"
                    Value="8,0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Centrar verticalmente contenido de las celdas -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
                            <Setter Property="Padding"
                    Value="6,0" />
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Nombre"
                        Binding="{Binding NombreCompleto}"
                        ElementStyle="{StaticResource DataGridTextCellStyle}"
                        Width="*" />

                        <DataGridTextColumn Header="Usuario"
                        Binding="{Binding NombreUsuario}"
                        ElementStyle="{StaticResource DataGridTextCellStyle}"
                        Width="170" />

                        <DataGridTextColumn Header="Rol"
                        Binding="{Binding NombreRol}"
                        ElementStyle="{StaticResource DataGridTextCellStyle}"
                        Width="160" />

                        <DataGridTextColumn Header="Estado"
                        Binding="{Binding EstadoTexto}"
                        ElementStyle="{StaticResource DataGridTextCellStyle}"
                        Width="120" />

                        <DataGridTextColumn Header="Creado"
                        Binding="{Binding FechaCreacion,
                            StringFormat={}{0:dd/MM/yyyy}}"
                        ElementStyle="{StaticResource DataGridTextCellStyle}"
                        Width="130" />

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

        <!-- Formulario Crear / Editar -->

        <Border Background="#990F172A"
                Visibility="{Binding MostrarFormulario,
                             Converter={StaticResource BoolToVisibility}}">

            <Border Width="500"
                    Padding="34"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="{Binding TituloFormulario}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#17365D" />

                    <TextBlock Text="Nombre completo"
                               Margin="0,24,0,6"
                               FontWeight="SemiBold" />

                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding NombreCompletoEdicion,
                                            UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Usuario"
                               Margin="0,16,0,6"
                               FontWeight="SemiBold" />

                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding NombreUsuarioEdicion,
                                            UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Rol"
                               Margin="0,16,0,6"
                               FontWeight="SemiBold" />

                    <ComboBox Style="{StaticResource FormComboBoxStyle}"
                              ItemsSource="{Binding RolesDisponibles}"
                              SelectedItem="{Binding RolSeleccionado}" />

                    <!-- Contraseña solo al crear -->

                    <StackPanel Visibility="{Binding EsNuevoUsuario,
                                 Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="Contraseña"
                                   Margin="0,16,0,6"
                                   FontWeight="SemiBold" />

                        <PasswordBox x:Name="PasswordNuevo"
                                     Style="{StaticResource FormPasswordBoxStyle}"
                                     PasswordChanged="PasswordNuevo_OnPasswordChanged" />

                        <TextBlock Text="Confirmar contraseña"
                                   Margin="0,16,0,6"
                                   FontWeight="SemiBold" />

                        <PasswordBox x:Name="ConfirmarPasswordNuevo"
                                     Style="{StaticResource FormPasswordBoxStyle}"
                                     PasswordChanged="ConfirmarPasswordNuevo_OnPasswordChanged" />

                    </StackPanel>

                    <TextBlock Text="{Binding MensajeError}"
                               Margin="0,14,0,0"
                               Foreground="#C62828"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,26,0,0">

                        <Button Content="Cancelar"
                                Width="100"
                                Height="40"
                                Margin="0,0,10,0"
                                Command="{Binding CancelarFormularioCommand}" />

                        <Button Content="Guardar"
                                Width="110"
                                Height="40"
                                Command="{Binding GuardarUsuarioCommand}"
                                Background="#0866E5"
                                Foreground="White"
                                BorderThickness="0" />

                    </StackPanel>

                </StackPanel>

            </Border>

        </Border>

        <!-- Restablecer contraseña -->

        <Border Background="#990F172A"
                Visibility="{Binding MostrarRestablecerPassword,
                             Converter={StaticResource BoolToVisibility}}">

            <Border Width="460"
                    Padding="34"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Cambiar contraseña"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#17365D" />

                    <TextBlock Text="{Binding UsuarioSeleccionado.NombreCompleto}"
                               Margin="0,6,0,20"
                               Foreground="#64748B" />

                    <TextBlock Text="Nueva contraseña"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />

                    <PasswordBox x:Name="NuevaPasswordInput"
                                 Style="{StaticResource FormPasswordBoxStyle}"
                                 PasswordChanged="NuevaPasswordInput_OnPasswordChanged" />

                    <TextBlock Text="Confirmar contraseña"
                               FontWeight="SemiBold"
                               Margin="0,16,0,6" />

                    <PasswordBox x:Name="ConfirmarNuevaPasswordInput"
                                 Style="{StaticResource FormPasswordBoxStyle}"
                                 PasswordChanged="ConfirmarNuevaPasswordInput_OnPasswordChanged" />

                    <TextBlock Text="{Binding MensajeError}"
                               Margin="0,14,0,0"
                               Foreground="#C62828"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,26,0,0">

                        <Button Content="Cancelar"
                                Width="100"
                                Height="40"
                                Margin="0,0,10,0"
                                Command="{Binding CancelarRestablecerPasswordCommand}" />

                        <Button Content="Guardar"
                                Width="110"
                                Height="40"
                                Command="{Binding GuardarNuevaPasswordCommand}"
                                Background="#0866E5"
                                Foreground="White"
                                BorderThickness="0" />

                    </StackPanel>

                </StackPanel>

            </Border>

        </Border>
        <!-- Notificación de éxito -->

        <Border HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,28,28"
        Padding="18,12"
        Background="#ECFDF3"
        BorderBrush="#86EFAC"
        BorderThickness="1"
        CornerRadius="8"
        Visibility="{Binding MostrarMensajeExito,
                     Converter={StaticResource BoolToVisibility}}">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="✓"
                   Margin="0,0,10,0"
                   Foreground="#15803D"
                   FontSize="16"
                   FontWeight="Bold"
                   VerticalAlignment="Center" />

                <TextBlock Text="{Binding MensajeExito}"
                   Foreground="#166534"
                   FontSize="14"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>

<UserControl x:Class="BodegaLuchito.Desktop.Modules.Caja.Views.Estados.HistorialCierresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:BodegaLuchito.Desktop.Modules.Caja.Views.Estados"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="620">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/CajaStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="HistorialHeaderStyle"
                   TargetType="DataGridColumnHeader">
                <Setter Property="Background"
                        Value="#F3F6FA" />
                <Setter Property="Foreground"
                        Value="{StaticResource ColorTextoPrincipal}" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="FontSize"
                        Value="12" />
                <Setter Property="Padding"
                        Value="10,8" />
                <Setter Property="BorderBrush"
                        Value="{StaticResource ColorBorde}" />
                <Setter Property="BorderThickness"
                        Value="0,0,0,1" />
            </Style>

            <Style x:Key="HistorialCellStyle"
                   TargetType="DataGridCell">

                <Setter Property="Padding"
                        Value="10,8" />

                <Setter Property="BorderThickness"
                        Value="0" />

                <Setter Property="Foreground"
                        Value="{StaticResource ColorTextoPrincipal}" />

            </Style>

            <Style x:Key="HistorialRowStyle"
                   TargetType="DataGridRow">

                <Setter Property="MinHeight"
                        Value="34" />
                <Setter Property="Background"
                        Value="White" />
                <Setter Property="BorderBrush"
                        Value="{StaticResource ColorBorde}" />
                <Setter Property="BorderThickness"
                        Value="0,0,0,1" />

            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="Ver detalle"
                        Command="{Binding VerDetalleCierreCommand}"
                        CommandParameter="{Binding CierreSeleccionado}"
                        Width="120"
                        Height="42"
                        Margin="0,0,10,0">

                    <Button.Style>

                        <Style TargetType="Button"
                               BasedOn="{StaticResource BotonPrimario}">

                            <Setter Property="IsEnabled"
                                    Value="True" />

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding CierreSeleccionado}"
                                             Value="{x:Null}">

                                    <Setter Property="IsEnabled"
                                            Value="False" />

                                    <Setter Property="Opacity"
                                            Value="0.55" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>

                </Button>

                <Button Content="Volver"
                        Command="{Binding VolverDesdeHistorialCommand}"
                        Style="{StaticResource BotonSecundario}"
                        Width="120"
                        Height="42" />

            </StackPanel>

        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource Tarjeta}"
                Padding="22">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Historial de cierres"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTextoPrincipal}" />

                        <TextBlock
                            Text="Consulta las sesiones cerradas y revisa los montos registrados en cada cierre de caja."
                            FontSize="13"
                            Foreground="{StaticResource ColorTextoSecundario}"
                            Margin="0,6,0,0"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Text="Puedes filtrar los registros o hacer clic en los encabezados para ordenarlos."
                            FontSize="13"
                            FontStyle="Italic"
                            Foreground="{StaticResource ColorAdvertencia}"
                            Margin="0,6,0,0"
                            TextWrapping="Wrap" />

                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{StaticResource ColorAcentoClaro}"
                            CornerRadius="14"
                            Padding="12,6"
                            VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding CantidadCierresMostrados,
                                           StringFormat='Mostrados: {0}'}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ColorAcento}" />

                    </Border>

                </Grid>

                <Border Grid.Row="2"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource ColorBorde}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Fecha desde"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ColorTextoPrincipal}"
                                       Margin="0,0,0,5" />

                            <DatePicker
                                SelectedDate="{Binding FechaDesdeFiltro}" />

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Fecha hasta"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ColorTextoPrincipal}"
                                       Margin="0,0,0,5" />

                            <DatePicker
                                SelectedDate="{Binding FechaHastaFiltro}" />

                        </StackPanel>

                        <StackPanel Grid.Column="4">

                            <TextBlock Text="Efectivo mín."
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ColorTextoPrincipal}"
                                       Margin="0,0,0,5" />

                            <TextBox
                                Width="140"
                                Height="25"
                                Text="{Binding MontoMinimoFiltroInput,
                                               UpdateSourceTrigger=PropertyChanged}" />

                        </StackPanel>

                        <StackPanel Grid.Column="6">

                            <TextBlock Text="Efectivo máx."
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ColorTextoPrincipal}"
                                       Margin="0,0,0,5" />

                            <TextBox
                                Width="140"
                                Height="25"
                                Text="{Binding MontoMaximoFiltroInput,
                                               UpdateSourceTrigger=PropertyChanged}" />

                        </StackPanel>

                        <Button Grid.Column="8"
                                Content="Filtrar"
                                Command="{Binding AplicarFiltrosHistorialCommand}"
                                Style="{StaticResource BotonPrimario}"
                                VerticalAlignment="Bottom" />

                        <!-- LIMPIAR -->
                        <Button Grid.Column="10"
                                Content="Limpiar"
                                Command="{Binding LimpiarFiltrosHistorialCommand}"
                                Style="{StaticResource BotonSecundario}"
                                VerticalAlignment="Bottom" />

                    </Grid>

                </Border>

                <DataGrid Grid.Row="4"
                          ItemsSource="{Binding HistorialCierresVista}"
                          SelectedItem="{Binding CierreSeleccionado,
                                                 Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="1"
                          BorderBrush="{StaticResource ColorBorde}"
                          Background="White"
                          RowStyle="{StaticResource HistorialRowStyle}"
                          CellStyle="{StaticResource HistorialCellStyle}"
                          ColumnHeaderStyle="{StaticResource HistorialHeaderStyle}"
                          AlternatingRowBackground="#FAFBFC"
                          RowBackground="White"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="N.°"
                            Binding="{Binding Id}"
                            SortMemberPath="Id"
                            Width="70" />

                        <DataGridTextColumn
                            Header="Apertura"
                            Binding="{Binding FechaApertura,
                                              StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                            SortMemberPath="FechaApertura"
                            Width="150" />

                        <DataGridTextColumn
                            Header="Cierre"
                            Binding="{Binding FechaCierre,
                                              StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                            SortMemberPath="FechaCierre"
                            Width="150" />

                        <DataGridTextColumn
                            Header="Fondo inicial"
                            Binding="{Binding FondoInicial,
                                              StringFormat=S/ {0:N2}}"
                            SortMemberPath="FondoInicial"
                            Width="120" />

                        <DataGridTextColumn
                            Header="Efectivo esperado"
                            Binding="{Binding EfectivoEsperado,
                                              StringFormat=S/ {0:N2}}"
                            SortMemberPath="EfectivoEsperado"
                            Width="140" />

                        <DataGridTextColumn
                            Header="Efectivo contado"
                            Binding="{Binding EfectivoReal,
                                              StringFormat=S/ {0:N2}}"
                            SortMemberPath="EfectivoReal"
                            Width="140" />

                        <DataGridTextColumn
                            Header="Diferencia"
                            Binding="{Binding DiferenciaEfectivo,
                                              StringFormat=S/ {0:N2}}"
                            SortMemberPath="DiferenciaEfectivo"
                            Width="120" />

                        <DataGridTextColumn
                            Header="Yape neto"
                            Binding="{Binding YapeNeto,
                                              StringFormat=S/ {0:N2}}"
                            SortMemberPath="YapeNeto"
                            Width="110" />

                        <DataGridTextColumn
                            Header="Plin neto"
                            Binding="{Binding PlinNeto,
                                              StringFormat=S/ {0:N2}}"
                            SortMemberPath="PlinNeto"
                            Width="110" />

                        <DataGridTextColumn
                            Header="Observación"
                            Binding="{Binding ObservacionCierre}"
                            SortMemberPath="ObservacionCierre"
                            Width="*" />

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

        <Grid Grid.RowSpan="2"
              Panel.ZIndex="10"
              Background="#66000000">
            <Grid.Style>

                <Style TargetType="Grid">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>

                        <DataTrigger Binding="{Binding MostrarDetalleCierre}"
                                     Value="True">

                            <Setter Property="Visibility"
                                    Value="Visible" />

                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <local:DetalleCierreView
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="900"
                MaxHeight="720"
                Margin="40" />
        </Grid>
    </Grid>
</UserControl>
<UserControl x:Class="BodegaLuchito.Desktop.Modules.Autenticacion.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Loaded="LoginView_OnLoaded" Unloaded="LoginView_OnUnloaded">

    <UserControl.Resources>

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="#17365D" />
            <Setter Property="Margin"
                    Value="0,0,0,7" />
        </Style>

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="48" />
            <Setter Property="FontSize"
                    Value="15" />
            <Setter Property="Padding"
                    Value="14,0" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="BorderBrush"
                    Value="#CBD5E1" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Background"
                    Value="White" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding EstaProcesando}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Border Width="500"
                Padding="42"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="14">

            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="4"
                                  Opacity="0.12" />
            </Border.Effect>

            <StackPanel>

                <!-- Icono -->
                <Border Width="70"
                        Height="70"
                        HorizontalAlignment="Center"
                        Background="#0F6CBD"
                        CornerRadius="35">

                    <Path Width="32" Height="32" Stretch="Uniform"
                          Stroke="White" StrokeThickness="1.8"
                          Data="M 3,10 L 5,3 L 19,3 L 21,10 M 3,10 C 3,14 7,14 8,10 C 8,14 12,14 12,10 C 12,14 16,14 16,10 C 17,14 21,14 21,10 M 5,14 L 5,22 L 19,22 L 19,14 M 10,22 L 10,16 L 15,16 L 15,22" />

                </Border>

                <TextBlock Text="Bienvenido a Bodega Luchito"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#15345B" />

                <TextBlock Text="Inicia sesión para continuar"
                           Margin="0,8,0,32"
                           HorizontalAlignment="Center"
                           FontSize="15"
                           Foreground="#64748B" />

                <!-- Usuario -->

                <TextBlock x:Name="UsuarioLabel" Text="Usuario"
                           Style="{StaticResource FieldLabelStyle}" />

                <TextBox x:Name="UsuarioInput" AutomationProperties.LabeledBy="{Binding ElementName=UsuarioLabel}" Text="{Binding NombreUsuario,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}" />

                <!-- Contraseña -->

                <TextBlock x:Name="PasswordLabel" Text="Contraseña"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,22,0,7" />

                                <Grid Height="48">
                    <PasswordBox x:Name="PasswordInput" Padding="14,0,52,0" FontSize="15"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1"
                                 AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}"
                                 PasswordChanged="PasswordInput_OnPasswordChanged" />
                    <TextBox x:Name="PasswordVisibleInput" Visibility="Collapsed" Padding="14,0,52,0"
                             Style="{StaticResource InputTextBoxStyle}" SpellCheck.IsEnabled="False"
                             AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}"
                             TextChanged="PasswordVisibleInput_OnTextChanged" />
                    <ToggleButton x:Name="MostrarPasswordButton" Width="44" Height="40" Margin="0,0,4,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                  Checked="MostrarPassword_OnChanged" Unchecked="MostrarPassword_OnChanged">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="AutomationProperties.Name" Value="Mostrar contraseña" />
                                <Setter Property="ToolTip" Value="Mostrar contraseña" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="AutomationProperties.Name" Value="Ocultar contraseña" />
                                        <Setter Property="ToolTip" Value="Ocultar contraseña" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <Grid Width="22" Height="18">
                            <Path Stroke="#17365D" StrokeThickness="1.6"
                                  Data="M 1,9 C 5,1 17,1 21,9 C 17,17 5,17 1,9 Z M 14,9 A 3,3 0 1 1 8,9 A 3,3 0 1 1 14,9" />
                            <Path Stroke="#17365D" StrokeThickness="1.6" Data="M 2,1 L 20,17">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=MostrarPasswordButton}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </ToggleButton>
                </Grid>

                <!-- Error -->

                <TextBlock AutomationProperties.LiveSetting="Assertive" Text="{Binding MensajeError}"
                           Margin="0,14,0,0"
                           Foreground="#C62828"
                           FontSize="13"
                           TextWrapping="Wrap" />   
                <!-- Botón -->

                <Button Margin="0,24,0,0"
                        Height="50"
                        IsDefault="True" Click="IniciarSesion_OnClick" Command="{Binding IniciarSesionCommand}"
                        Background="#0866E5"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Cursor="Hand">

                                        <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Iniciar sesión" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstaProcesando}" Value="True">
                                        <Setter Property="Text" Value="Ingresando…" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Button>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>

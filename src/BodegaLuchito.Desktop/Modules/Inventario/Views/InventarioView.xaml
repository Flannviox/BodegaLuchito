<UserControl x:Class="BodegaLuchito.Desktop.Modules.Inventario.Views.InventarioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:productos="clr-namespace:BodegaLuchito.Desktop.Modules.Productos.Views"
    Background="#F7F9FC" Foreground="#17365D" FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#17437A"/>
            <Setter Property="BorderBrush" Value="#CBDCF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Marco" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#123968"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Marco" Property="BorderBrush" Value="#1467DC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="#BFDBFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Principal" TargetType="Button" BasedOn="{StaticResource Boton}">
            <Setter Property="Background" Value="#1467DC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1467DC"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#17365D"/>
        </Style>
        <Style TargetType="DatePicker">
            <Style.Resources>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Foreground" Value="#17365D"/>
                </Style>
            </Style.Resources>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#456385"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE7F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="MensajeError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#991B1B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextoCelda" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EDF7"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="MinRowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFD"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EFF5FC"/>
            <Setter Property="Foreground" Value="#456385"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#17365D"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#123968"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Foreground" Value="#456385"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabMarco" Padding="{TemplateBinding Padding}" Margin="0,0,8,8" Background="White" CornerRadius="6">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabMarco" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#123968"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabMarco" Property="Background" Value="#1467DC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DialogoVisible}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AltaProducto.Visible}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource Tarjeta}" Margin="0,0,8,0" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Productos activos" Foreground="#456385" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TotalActivos}" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tarjeta}" Margin="0,0,8,0" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Stock bajo" Foreground="#456385"/>
                        <TextBlock Text="{Binding StockBajo}" FontSize="24" Foreground="#A65B00" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tarjeta}" Margin="0,0,8,0" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Agotados" Foreground="#456385"/>
                        <TextBlock Text="{Binding Agotados}" FontSize="24" Foreground="#B42318" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tarjeta}" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Pendientes de saldo inicial" Foreground="#456385" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PendientesInicial}" FontSize="24" Foreground="#1467DC" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Grid.Row="1" Text="{Binding Error}" Style="{StaticResource MensajeError}"/>
            <TabControl Grid.Row="2" SelectedIndex="{Binding Pestana}" BorderThickness="0" Background="Transparent" Padding="0">
                <TabItem Header="Existencias">
                    <Border Style="{StaticResource Tarjeta}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel IsEnabled="{Binding Disponible}">
                                <StackPanel Width="230" Margin="0,0,12,8">
                                    <TextBlock Text="Buscar producto o código" Style="{StaticResource Etiqueta}"/>
                                    <TextBox Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="0,0,12,8">
                                    <TextBlock Text="Categoría" Style="{StaticResource Etiqueta}"/>
                                    <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding Categoria}"/>
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,12,8">
                                    <TextBlock Text="Estado" Style="{StaticResource Etiqueta}"/>
                                    <ComboBox ItemsSource="{Binding Estados}" SelectedItem="{Binding Estado}"/>
                                </StackPanel>
                                <Button Content="Limpiar" Style="{StaticResource Boton}" VerticalAlignment="Bottom" Command="{Binding LimpiarCommand}"/>
                            </WrapPanel>
                            <WrapPanel Grid.Row="1" IsEnabled="{Binding Disponible}">
                                <Button Content="+ Inventario inicial" Style="{StaticResource Principal}" Command="{Binding AbrirInicialCommand}"/>
                                <Button Content="+ Producto y saldo inicial" Style="{StaticResource Boton}" Command="{Binding AbrirProductoNuevoCommand}"/>
                                <Button Content="Ajustar por conteo" Style="{StaticResource Boton}" Command="{Binding AbrirConteoCommand}"/>
                                <Button Content="Pérdida o daño" Style="{StaticResource Boton}" Command="{Binding AbrirMermaCommand}"/>
                                <Button Content="Actualizar lista" Style="{StaticResource Boton}" Command="{Binding ActualizarCommand}"/>
                            </WrapPanel>
                            <Grid Grid.Row="2">
                                <DataGrid ItemsSource="{Binding Existencias}" SelectedItem="{Binding Seleccionado}" IsEnabled="{Binding Disponible}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="2*" MinWidth="165" ElementStyle="{StaticResource TextoCelda}"/>
                                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="1.25*" MinWidth="120" ElementStyle="{StaticResource TextoCelda}"/>
                                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*" MinWidth="110" ElementStyle="{StaticResource TextoCelda}"/>
                                        <DataGridTextColumn Header="Stock actual" Binding="{Binding StockActual, StringFormat={}{0:0.###}}" Width="100" MinWidth="100" ElementStyle="{StaticResource TextoCelda}"/>
                                        <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo, StringFormat={}{0:0.###}}" Width="80" MinWidth="80" ElementStyle="{StaticResource TextoCelda}"/>
                                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="65" MinWidth="65" ElementStyle="{StaticResource TextoCelda}"/>
                                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110" MinWidth="110" ElementStyle="{StaticResource TextoCelda}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="No hay productos que coincidan con los filtros." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding Existencias.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Grid.Row="3" Text="{Binding ConteoExistencias}" Foreground="#64748B" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="Movimientos">
                    <Border Style="{StaticResource Tarjeta}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel>
                                <StackPanel Width="190" Margin="0,0,10,8">
                                    <TextBlock Text="Producto o motivo" Style="{StaticResource Etiqueta}"/>
                                    <TextBox Text="{Binding BusquedaMovimiento, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Width="165" Margin="0,0,10,8">
                                    <TextBlock Text="Tipo de movimiento" Style="{StaticResource Etiqueta}"/>
                                    <ComboBox ItemsSource="{Binding TiposMovimiento}" SelectedItem="{Binding TipoMovimiento}"/>
                                </StackPanel>
                                <StackPanel Width="165" Margin="0,0,10,8">
                                    <TextBlock Text="Desde" Style="{StaticResource Etiqueta}"/>
                                    <DatePicker SelectedDate="{Binding Desde}" Height="36"/>
                                </StackPanel>
                                <StackPanel Width="165" Margin="0,0,10,8">
                                    <TextBlock Text="Hasta" Style="{StaticResource Etiqueta}"/>
                                    <DatePicker SelectedDate="{Binding Hasta}" Height="36"/>
                                </StackPanel>
                                <Button Content="Limpiar" Style="{StaticResource Boton}" VerticalAlignment="Bottom" Command="{Binding LimpiarCommand}"/>
                                <Button Content="Actualizar" Style="{StaticResource Boton}" VerticalAlignment="Bottom" IsEnabled="{Binding Disponible}" Command="{Binding ActualizarCommand}"/>
                            </WrapPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Movimientos}" SelectedItem="{Binding MovimientoSeleccionado}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140" MinWidth="140" ElementStyle="{StaticResource TextoCelda}"/>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*" MinWidth="155" ElementStyle="{StaticResource TextoCelda}"/>
                                    <DataGridTextColumn Header="Movimiento" Binding="{Binding TipoDescripcion}" Width="155" MinWidth="155" ElementStyle="{StaticResource TextoCelda}"/>
                                    <DataGridTextColumn Header="Variación" Binding="{Binding Variacion, StringFormat={}{0:+0.###;-0.###;0}}" Width="90" MinWidth="90" ElementStyle="{StaticResource TextoCelda}"/>
                                    <DataGridTextColumn Header="Anterior" Binding="{Binding StockAnterior, StringFormat={}{0:0.###}}" Width="85" MinWidth="85" ElementStyle="{StaticResource TextoCelda}"/>
                                    <DataGridTextColumn Header="Posterior" Binding="{Binding StockPosterior, StringFormat={}{0:0.###}}" Width="85" MinWidth="85" ElementStyle="{StaticResource TextoCelda}"/>
                                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="65" MinWidth="65" ElementStyle="{StaticResource TextoCelda}"/>
                                    <DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="140" MinWidth="140" ElementStyle="{StaticResource TextoCelda}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Text="{Binding ConteoMovimientos}" Foreground="#64748B"/>
                                <TextBlock Text="{Binding MovimientoSeleccionado.Motivo}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding MovimientoSeleccionado.AbastecimientoId, StringFormat=Abastecimiento asociado: #{0}}" Foreground="#456385">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MovimientoSeleccionado.AbastecimientoId}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MovimientoSeleccionado}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Background="#880F172A" Visibility="{Binding DialogoVisible, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource Tarjeta}" Margin="16" Padding="20" MaxWidth="540" MaxHeight="590" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding TituloOperacion}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel IsEnabled="{Binding Disponible}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding ExplicacionOperacion}" Foreground="#456385" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="Producto" Style="{StaticResource Etiqueta}"/>
                            <ComboBox ItemsSource="{Binding ProductosOperacion}" SelectedItem="{Binding ProductoOperacion}" DisplayMemberPath="Nombre" TextSearch.TextPath="Nombre"/>
                            <TextBlock Text="{Binding IndicacionUnidad}" TextWrapping="Wrap" Foreground="#456385" FontSize="12" Margin="0,6,0,12"/>
                            <TextBlock Text="{Binding EtiquetaCantidad}" Style="{StaticResource Etiqueta}"/>
                            <TextBox Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"/>
                            <TextBlock Text="Motivo del registro" Style="{StaticResource Etiqueta}" Margin="0,12,0,5"/>
                            <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="64" VerticalScrollBarVisibility="Auto" MaxLength="250"/>
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ResumenOperacion}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Se conservará en el historial. No requiere proveedor ni genera un pago en Caja."
                                               TextWrapping="Wrap" Foreground="#456385" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="{Binding ErrorFormulario}" Style="{StaticResource MensajeError}"/>
                        <WrapPanel HorizontalAlignment="Right" IsEnabled="{Binding Disponible}">
                            <Button Content="Cancelar" Style="{StaticResource Boton}" Command="{Binding CancelarCommand}" Margin="0,0,8,0"/>
                            <Button Content="Confirmar registro" Style="{StaticResource Principal}" Command="{Binding GuardarCommand}" Margin="0"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="16,12" MaxWidth="500"
                CornerRadius="7" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" IsHitTestVisible="False"
                Visibility="{Binding AvisoVisible, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" Foreground="#065F46" FontWeight="SemiBold"/>
        </Border>
        <productos:NuevoProductoIngresoView DataContext="{Binding AltaProducto}"
            Visibility="{Binding Visible, Converter={StaticResource Visible}}"/>
    </Grid>
</UserControl>

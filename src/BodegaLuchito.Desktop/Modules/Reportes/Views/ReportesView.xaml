<UserControl x:Class="BodegaLuchito.Desktop.Modules.Reportes.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             Background="#F8FAFC"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TARJETAS SUPERIORES -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tarjeta 1: Total Ventas -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Total ventas" FontSize="14" Foreground="#64748B" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalVentas, StringFormat=S/ {0:N2}}" FontSize="28" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>
                    <TextBlock Text="En el periodo seleccionado" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 2: Total Egresos -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Total egresos" FontSize="14" Foreground="#64748B" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalEgresos, StringFormat=S/ {0:N2}}" FontSize="28" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>
                    <TextBlock Text="Pagos a proveedores en periodo" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 3: Diferencia de Caja -->
            <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Diferencia referencial" FontSize="14" Foreground="#64748B" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DiferenciaCaja, StringFormat=S/ {0:N2}}" FontSize="28" Foreground="#3B82F6" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>
                    <TextBlock Text="Ventas - Egresos (Sin fondo base)" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BARRA DE FILTROS -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Rango de fechas" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding FechaInicio}" Width="130" Height="35" Margin="0,0,10,0"/>
                        <TextBlock Text="Hasta" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,10,0"/>
                        <DatePicker SelectedDate="{Binding FechaFin}" Width="130" Height="35"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tipo de reporte" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding TiposReporte}" SelectedItem="{Binding TipoReporteSeleccionado}" Width="200" Height="35" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Command="{Binding LimpiarFiltrosCommand}" Content="Limpiar (F3)" Width="110" Height="35" Background="Transparent" Foreground="#64748B" BorderBrush="#CBD5E1" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Command="{Binding GenerarReporteCommand}" Content="Generar reporte (F2)" Width="150" Height="35" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RESULTADOS Y EXPORTACIÓN -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                    <Button Command="{Binding ExportarExcelCommand}" Content="Exportar a Excel (F4)" Width="150" Height="35" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- El DataGrid se adapta automáticamente al DTO que devuelva la base de datos (AutoGenerateColumns="True") -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Resultados}" AutoGenerateColumns="True" IsReadOnly="True" 
                          CanUserAddRows="False" HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          RowHeight="40" AlternatingRowBackground="#F8FAFC" HorizontalGridLinesBrush="#F1F5F9" VerticalGridLinesBrush="Transparent">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

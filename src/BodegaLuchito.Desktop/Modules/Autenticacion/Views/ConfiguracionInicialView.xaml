<UserControl x:Class="BodegaLuchito.Desktop.Modules.Autenticacion.Views.ConfiguracionInicialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">

        <Border Width="520"
                Padding="42"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="14">

            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="4"
                                  Opacity="0.12" />
            </Border.Effect>

            <StackPanel>

                <TextBlock Text="Configuración inicial"
                           HorizontalAlignment="Center"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#15345B" />

                <TextBlock Text="Crea la cuenta administradora del sistema"
                           Margin="0,8,0,28"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Foreground="#64748B" />

                <TextBlock Text="Nombre completo"
                           FontWeight="SemiBold"
                           Foreground="#17365D"
                           Margin="0,0,0,7" />

                <TextBox Height="46"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding NombreCompleto,
                                        UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Usuario"
                           Margin="0,18,0,7"
                           FontWeight="SemiBold"
                           Foreground="#17365D" />

                <TextBox Height="46"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding NombreUsuario,
                                        UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Contraseña"
                           Margin="0,18,0,7"
                           FontWeight="SemiBold"
                           Foreground="#17365D" />

                <PasswordBox x:Name="PasswordInput"
                             Height="46"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             PasswordChanged="PasswordInput_OnPasswordChanged" />

                <TextBlock Text="Confirmar contraseña"
                           Margin="0,18,0,7"
                           FontWeight="SemiBold"
                           Foreground="#17365D" />

                <PasswordBox x:Name="ConfirmPasswordInput"
                             Height="46"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             PasswordChanged="ConfirmPasswordInput_OnPasswordChanged" />

                <TextBlock Text="{Binding MensajeError}"
                           Margin="0,14,0,0"
                           Foreground="#C62828"
                           FontSize="13"
                           TextWrapping="Wrap" />

                <Button Height="50"
                        Margin="0,24,0,0"
                        Command="{Binding CrearAdministradorCommand}"
                        Background="#0866E5"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Content="Crear administradora" />

            </StackPanel>

        </Border>

    </Grid>

</UserControl>

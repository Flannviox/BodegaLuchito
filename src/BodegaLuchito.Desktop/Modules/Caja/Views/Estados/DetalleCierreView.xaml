<UserControl x:Class="BodegaLuchito.Desktop.Modules.Caja.Views.Estados.DetalleCierreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cajaEnums="clr-namespace:BodegaLuchito.Domain.Caja.Enums;assembly=BodegaLuchito.Domain"
             xmlns:sharedEnums="clr-namespace:BodegaLuchito.Domain.Shared.Enums;assembly=BodegaLuchito.Domain"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="650">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/CajaStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ChipTipoMovimiento"
                   TargetType="Border">
                <Setter Property="CornerRadius"
                        Value="12" />
                <Setter Property="Padding"
                        Value="10,4" />
                <Setter Property="Background"
                        Value="{StaticResource ColorAcentoClaro}" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tipo}"
                                 Value="{x:Static cajaEnums:TipoMovimientoCaja.IngresoVenta}">
                        <Setter Property="Background"
                                Value="{StaticResource ColorExitoClaro}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Tipo}"
                                 Value="{x:Static cajaEnums:TipoMovimientoCaja.EgresoAbastecimiento}">
                        <Setter Property="Background"
                                Value="{StaticResource ColorErrorFondo}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Tipo}"
                                 Value="{x:Static cajaEnums:TipoMovimientoCaja.ReversionVenta}">
                        <Setter Property="Background"
                                Value="{StaticResource ColorAdvertenciaClaro}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TextoTipoMovimiento"
                   TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="12" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="Text"
                        Value="{Binding Tipo}" />
                <Setter Property="Foreground"
                        Value="{StaticResource ColorAcento}" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tipo}"
                                 Value="{x:Static cajaEnums:TipoMovimientoCaja.IngresoVenta}">
                        <Setter Property="Text"
                                Value="Ingreso" />
                        <Setter Property="Foreground"
                                Value="{StaticResource ColorExito}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Tipo}"
                                 Value="{x:Static cajaEnums:TipoMovimientoCaja.EgresoAbastecimiento}">
                        <Setter Property="Text"
                                Value="Egreso" />
                        <Setter Property="Foreground"
                                Value="{StaticResource ColorError}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Tipo}"
                                 Value="{x:Static cajaEnums:TipoMovimientoCaja.ReversionVenta}">
                        <Setter Property="Text"
                                Value="Reversión" />
                        <Setter Property="Foreground"
                                Value="{StaticResource ColorAdvertencia}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ChipMetodoPago"
                   TargetType="Border">
                <Setter Property="CornerRadius"
                        Value="12" />
                <Setter Property="Padding"
                        Value="10,4" />
                <Setter Property="Background"
                        Value="{StaticResource ColorAcentoClaro}" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding MetodoPago}"
                                 Value="{x:Static sharedEnums:MetodoPago.Efectivo}">
                        <Setter Property="Background"
                                Value="#E8F2FC" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding MetodoPago}"
                                 Value="{x:Static sharedEnums:MetodoPago.Yape}">
                        <Setter Property="Background"
                                Value="#F3E8FF" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding MetodoPago}"
                                 Value="{x:Static sharedEnums:MetodoPago.Plin}">
                        <Setter Property="Background"
                                Value="#E7F3FF" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="IconoMetodoPago"
                   TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize"
                        Value="12" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="Margin"
                        Value="0,0,5,0" />
                <Setter Property="Foreground"
                        Value="{StaticResource ColorAcento}" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding MetodoPago}"
                                 Value="{x:Static sharedEnums:MetodoPago.Efectivo}">
                        <Setter Property="Text"
                                Value="&#xEC59;" />
                        <Setter Property="Foreground"
                                Value="{StaticResource ColorExito}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding MetodoPago}"
                                 Value="{x:Static sharedEnums:MetodoPago.Yape}">
                        <Setter Property="Text"
                                Value="&#xE717;" />
                        <Setter Property="Foreground"
                                Value="#7C3AED" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding MetodoPago}"
                                 Value="{x:Static sharedEnums:MetodoPago.Plin}">
                        <Setter Property="Text"
                                Value="&#xE717;" />
                        <Setter Property="Foreground"
                                Value="#1683D8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TextoMetodoPago"
                   TargetType="TextBlock">
                <Setter Property="Text"
                        Value="{Binding MetodoPago}" />
                <Setter Property="FontSize"
                        Value="12" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="Foreground"
                        Value="{StaticResource ColorAcento}" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding MetodoPago}"
                                 Value="{x:Static sharedEnums:MetodoPago.Efectivo}">
                        <Setter Property="Foreground"
                                Value="{StaticResource ColorExito}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding MetodoPago}"
                                 Value="{x:Static sharedEnums:MetodoPago.Yape}">
                        <Setter Property="Foreground"
                                Value="#7C3AED" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding MetodoPago}"
                                 Value="{x:Static sharedEnums:MetodoPago.Plin}">
                        <Setter Property="Foreground"
                                Value="#1683D8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="IndicadorTipoMovimiento"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="{StaticResource ColorAcento}" />

                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tipo}"
                                 Value="{x:Static cajaEnums:TipoMovimientoCaja.IngresoVenta}">
                        <Setter Property="Background"
                                Value="{StaticResource ColorExito}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Tipo}"
                                 Value="{x:Static cajaEnums:TipoMovimientoCaja.EgresoAbastecimiento}">
                        <Setter Property="Background"
                                Value="{StaticResource ColorError}" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Tipo}"
                                 Value="{x:Static cajaEnums:TipoMovimientoCaja.ReversionVenta}">
                        <Setter Property="Background"
                                Value="{StaticResource ColorAdvertencia}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="{StaticResource ColorBorde}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            MaxWidth="920">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        Text="{Binding CierreSeleccionado.Id,
                                       StringFormat='Detalle del cierre #{0}'}"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ColorTextoPrincipal}" />

                    <TextBlock
                        Text="Revisa los movimientos registrados durante esta sesión de caja."
                        FontSize="13"
                        Foreground="{StaticResource ColorTextoSecundario}"
                        Margin="0,5,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Cerrar"
                        Command="{Binding CerrarDetalleCierreCommand}"
                        Style="{StaticResource BotonSecundario}"
                        MinWidth="90"
                        Margin="20,0,0,0" />
            </Grid>

            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="APERTURA"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTextoSecundario}" />

                        <TextBlock
                            Text="{Binding CierreSeleccionado.FechaApertura,
                                           StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ColorTextoPrincipal}"
                            Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CIERRE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTextoSecundario}" />

                        <TextBlock
                            Text="{Binding CierreSeleccionado.FechaCierre,
                                           StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ColorTextoPrincipal}"
                            Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="{StaticResource ColorErrorFondo}"
                            CornerRadius="14"
                            Padding="12,6"
                            VerticalAlignment="Center">

                        <TextBlock Text="Sesión cerrada"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorError}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Movimientos de la sesión"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ColorTextoPrincipal}" />

                        <TextBlock Text="Ventas y abastecimientos asociados a este cierre."
                                   FontSize="12"
                                   Foreground="{StaticResource ColorTextoSecundario}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{StaticResource ColorAcentoClaro}"
                            CornerRadius="14"
                            Padding="12,6"
                            VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding MovimientosCierreSeleccionado.Count,
                                           StringFormat='Movimientos: {0}'}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ColorAcento}" />
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              MaxHeight="410"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding MovimientosCierreSeleccionado}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="White"
                                        BorderBrush="#CCD6E2"
                                        BorderThickness="1.2"
                                        CornerRadius="9"
                                        Margin="0,0,4,14">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Style="{StaticResource IndicadorTipoMovimiento}"
                                                CornerRadius="8,0,0,8" />

                                        <StackPanel Grid.Column="1"
                                                    Margin="16,14,16,12">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding Descripcion}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource ColorTextoPrincipal}" />

                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,8,0,0">

                                                        <Border Style="{StaticResource ChipTipoMovimiento}"
                                                                Margin="0,0,8,0">

                                                            <TextBlock
                                                                Style="{StaticResource TextoTipoMovimiento}" />

                                                        </Border>

                                                        <Border Style="{StaticResource ChipMetodoPago}"
                                                                Margin="0,0,10,0">

                                                            <StackPanel Orientation="Horizontal">

                                                                <TextBlock
                                                                    Style="{StaticResource IconoMetodoPago}" />

                                                                <TextBlock
                                                                    Style="{StaticResource TextoMetodoPago}" />

                                                            </StackPanel>

                                                        </Border>

                                                        <TextBlock
                                                            Text="{Binding FechaHora,
                                                                           StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                            FontSize="12"
                                                            Foreground="{StaticResource ColorTextoSecundario}"
                                                            VerticalAlignment="Center" />

                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Monto,
                                                                          StringFormat=S/ {0:N2}}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="20,0,0,0">

                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource ColorTextoPrincipal}" />

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tipo}"
                                                                             Value="{x:Static cajaEnums:TipoMovimientoCaja.IngresoVenta}">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource ColorExito}" />
                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding Tipo}"
                                                                             Value="{x:Static cajaEnums:TipoMovimientoCaja.EgresoAbastecimiento}">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource ColorError}" />
                                                                </DataTrigger>

                                                                <DataTrigger Binding="{Binding Tipo}"
                                                                             Value="{x:Static cajaEnums:TipoMovimientoCaja.ReversionVenta}">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource ColorAdvertencia}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Detalles}"
                                                          Margin="0,12,0,0">

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>

                                                        <Border Background="#F8FAFC"
                                                                BorderBrush="#E1E7EE"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="10,7"
                                                                Margin="0,3,0,0">

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="150" />
                                                                    <ColumnDefinition Width="100" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0"
                                                                            Orientation="Horizontal">

                                                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                               Text="&#xE7B8;"
                                                                               FontSize="13"
                                                                               Foreground="#8190A3"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,8,0" />

                                                                    <TextBlock Text="{Binding ProductoNombre}"
                                                                               FontSize="13"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource ColorTextoPrincipal}" />
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="1"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource ColorTextoSecundario}">

                                                                    <Run Text="{Binding Cantidad}" />
                                                                    <Run Text=" x S/ " />
                                                                    <Run Text="{Binding PrecioUnitario,
                                                                                       StringFormat={}{0:N2}}" />

                                                                </TextBlock>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding Subtotal,
                                                                                          StringFormat=S/ {0:N2}}"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource ColorTextoPrincipal}" />
                                                            </Grid>
                                                        </Border>

                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Button Grid.Row="6"
                    Content="Cerrar detalle"
                    Command="{Binding CerrarDetalleCierreCommand}"
                    Style="{StaticResource BotonSecundario}"
                    Width="140"
                    HorizontalAlignment="Right" />

        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="BodegaLuchito.Desktop.Modules.BI.Views.PrediccionDemandaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Unloaded="AlSalir" Background="#F7F9FC" Foreground="#17365D" FontSize="13" Language="es-PE">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#1467DC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Marco" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="#1467DC" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#123968"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Marco" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="#BFDBFE"/>
                                <Setter Property="Foreground" Value="#123968"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="DatePicker">
            <Style.Resources>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4"/>
                </Style>
            </Style.Resources>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE6F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EFF5FC"/>
            <Setter Property="Foreground" Value="#456385"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#17365D"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#123968"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TextoCelda" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="MinHeight" Value="600"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DetallesVisibles}" Value="True">
                        <Setter Property="MinHeight" Value="760"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="¿Qué productos podrían faltarte?" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Revisa si lo que tienes alcanzaría para los próximos tres días, según las ventas anteriores."
                    TextWrapping="Wrap" Margin="0,6,0,8"/>
                <TextBlock Text="{Binding AvisoOrigen}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#456385"/>
                <WrapPanel IsEnabled="{Binding Disponible}">
                    <StackPanel Width="195" Margin="0,0,16,8">
                        <TextBlock Text="¿Qué quieres consultar?" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Fuentes}" SelectedItem="{Binding Fuente}"/>
                    </StackPanel>
                    <StackPanel Width="190" Margin="0,0,16,8" Visibility="{Binding EsNegocio, Converter={StaticResource Visible}}">
                        <TextBlock Text="Registré mis ventas desde" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding Desde}" DisplayDateStart="{Binding FechaMinima, Mode=OneWay}"
                            DisplayDateEnd="{Binding FechaMaxima, Mode=OneWay}"/>
                    </StackPanel>
                    <Button Content="Revisar productos" Command="{Binding AnalizarCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                </WrapPanel>
                <CheckBox IsChecked="{Binding HistorialCompleto}" IsEnabled="{Binding Disponible}"
                    Visibility="{Binding EsNegocio, Converter={StaticResource Visible}}">
                    <TextBlock Text="He registrado todas las ventas desde esa fecha. Si un día no tiene registros, no hubo ventas." TextWrapping="Wrap"/>
                </CheckBox>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Resumen}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,5,8,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Cancelar revisión" Command="{Binding CancelarCommand}"
                Visibility="{Binding Ocupado, Converter={StaticResource Visible}}"/>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid ItemsSource="{Binding Resultados}" SelectedItem="{Binding Seleccionado}" AutoGenerateColumns="False"
                IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow"
                BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFD"
                GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5EDF7" MinRowHeight="44" ColumnHeaderHeight="42"
                ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*" MinWidth="180" ElementStyle="{StaticResource TextoCelda}"/>
                    <DataGridTextColumn Header="Tienes ahora" Binding="{Binding Existencias, Mode=OneWay}" Width="140" MinWidth="140" ElementStyle="{StaticResource TextoCelda}"/>
                    <DataGridTextColumn Header="Podrías vender en 3 días" Binding="{Binding VentaPosible, Mode=OneWay}" Width="200" MinWidth="200" ElementStyle="{StaticResource TextoCelda}"/>
                    <DataGridTemplateColumn Header="¿Alcanzaría?" Width="160" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,4" Margin="5" CornerRadius="5" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EFF5FC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Riesgo}" Value="Alto"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Riesgo}" Value="Medio"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Riesgo}" Value="Bajo"><Setter Property="Background" Value="#DCFCE7"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Situacion}" Foreground="#17365D" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Tarjeta}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{Binding TituloDetalle}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="{Binding DetalleSeleccion}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Border Background="#FFF7E6" CornerRadius="5" Padding="8" Margin="0,8,0,0"
                        Visibility="{Binding TieneAdvertencia, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding AdvertenciaSeleccion}" TextWrapping="Wrap" Foreground="#7C4A03"/>
                </Border>
                <TextBlock Text="Esta consulta te ayuda a planificar; no realiza compras ni cambia tus existencias." TextWrapping="Wrap" Foreground="#456385" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding FechaCalculo}" TextWrapping="Wrap" Foreground="#456385" FontSize="12" Margin="0,4,0,0"/>
                <Expander Header="Ver detalles del cálculo" IsExpanded="{Binding DetallesVisibles}" Margin="0,8,0,0">
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="6,8">
                            <TextBlock Text="{Binding DetalleTecnico}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Evaluacion}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="Las ventas no registradas y los días sin existencias pueden hacer que el cálculo sea menor que la demanda real. Las unidades se muestran redondeadas hacia arriba solo para facilitar su lectura."
                                TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>

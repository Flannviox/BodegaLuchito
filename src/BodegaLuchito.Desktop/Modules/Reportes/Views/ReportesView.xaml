<UserControl x:Class="BodegaLuchito.Desktop.Modules.Reportes.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             Background="#F4F7FB"
             d:DesignHeight="750" d:DesignWidth="1100">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO DE LA VISTA -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Reportes Comerciales" FontSize="26" FontWeight="Bold" Foreground="#153657"/>
            <TextBlock Text="Consulta, filtra y exporta la información operativa de la bodega." FontSize="14" Foreground="#6E839C" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- SECCIÓN SUPERIOR: FILTROS Y TARJETAS -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL DE FILTROS -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E1E8F1" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.03" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Configurar Reporte" FontSize="16" FontWeight="SemiBold" Foreground="#153657" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Rango de fechas:" FontSize="13" FontWeight="SemiBold" Foreground="#6E839C" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" SelectedDate="{Binding FechaInicio}" Height="38" FontSize="14" BorderBrush="#CBD5E1" Background="#F8FAFC"/>
                            <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="10,0" Foreground="#6E839C" FontWeight="Bold"/>
                            <DatePicker Grid.Column="2" SelectedDate="{Binding FechaFin}" Height="38" FontSize="14" BorderBrush="#CBD5E1" Background="#F8FAFC"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                        <TextBlock Text="Tipo de información:" FontSize="13" FontWeight="SemiBold" Foreground="#6E839C" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding TiposReporte}" SelectedItem="{Binding TipoReporteSeleccionado}" Height="38" FontSize="14" Padding="10,0" BorderBrush="#CBD5E1" Background="#F8FAFC"/>
                    </StackPanel>

                    <!-- BOTONES DE ACCIÓN (Generar y Limpiar) -->
                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding LimpiarFiltrosCommand}" Content="Restablecer" Height="40" Background="Transparent" Foreground="#6E839C" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2" Command="{Binding GenerarReporteCommand}" Content="Generar (F2)" Height="40" Background="#1767D8" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- TARJETAS DE RESUMEN -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ingresos -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E1E8F1" BorderThickness="1" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" Opacity="0.03" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="40" Height="40" Background="#E0F2FE" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,15">
                            <TextBlock Text="💰" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ingresos del Periodo" FontSize="13" FontWeight="SemiBold" Foreground="#6E839C"/>
                        <TextBlock Text="{Binding TotalVentas, StringFormat=S/ {0:N2}}" FontSize="28" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,5,0,0"/>
                        <TextBlock Text="Total por ventas" FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Egresos -->
                <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#E1E8F1" BorderThickness="1" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" Opacity="0.03" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="40" Height="40" Background="#FEE2E2" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,15">
                            <TextBlock Text="📉" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Egresos del Periodo" FontSize="13" FontWeight="SemiBold" Foreground="#6E839C"/>
                        <TextBlock Text="{Binding TotalEgresos, StringFormat=S/ {0:N2}}" FontSize="28" FontWeight="Bold" Foreground="#EF4444" Margin="0,5,0,0"/>
                        <TextBlock Text="Pagos a proveedores" FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Diferencia -->
                <Border Grid.Column="4" Background="White" CornerRadius="10" BorderBrush="#E1E8F1" BorderThickness="1" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" Opacity="0.03" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="40" Height="40" Background="#ECFDF5" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,15">
                            <TextBlock Text="⚖️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Diferencia Neta" FontSize="13" FontWeight="SemiBold" Foreground="#6E839C"/>
                        <TextBlock Text="{Binding DiferenciaCaja, StringFormat=S/ {0:N2}}" FontSize="28" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                        <TextBlock Text="Ingresos menos egresos" FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- SECCIÓN INFERIOR: RESULTADOS Y EXPORTACIÓN -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E1E8F1" BorderThickness="1" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.03" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Detalle de Resultados" FontSize="16" FontWeight="SemiBold" Foreground="#153657"/>
                        <TextBlock Text="Vista previa de los datos obtenidos en la base de datos." FontSize="13" Foreground="#6E839C"/>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding ExportarExcelCommand}" Height="40" Padding="20,0" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Exportar a Excel (F4)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Resultados}" AutoGenerateColumns="True" IsReadOnly="True" 
                              CanUserAddRows="False" HeadersVisibility="Column" Background="White" BorderThickness="0"
                              RowHeight="45" AlternatingRowBackground="#F8FAFC" HorizontalGridLinesBrush="#F1F5F9" VerticalGridLinesBrush="Transparent">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="15,12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="15,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0F2FE"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

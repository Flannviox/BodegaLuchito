<UserControl x:Class="BodegaLuchito.Desktop.Modules.Productos.Views.RegistrarProductoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BodegaLuchito.Desktop.Common.Converters"
             Background="#F7F9FC">
    <UserControl.Resources>
        <converters:DecimalFlexibleConverter x:Key="DecimalFlexibleConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1467DC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0F56BC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5DFEC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F6FF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#9FC1F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#059669"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334E71"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FilterBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="GridText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.25*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="8" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Buscar y filtrar productos" FontSize="15" FontWeight="Bold" Foreground="#17365D"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="102"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="BuscarProductoTextBox" Style="{StaticResource InputBox}"
                                         Height="40" BorderBrush="#2377E8" BorderThickness="2"
                                         Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Escanee código de barras o escriba el producto..."
                                           Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#94A3B8"
                                           FontSize="13" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=BuscarProductoTextBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="2" Content="Buscar" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BuscarCommand}"/>
                            <Button Grid.Column="4" Content="Limpiar" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding LimpiarFiltrosCommand}"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource FilterBox}" ItemsSource="{Binding CategoriasFiltro}"
                                          SelectedItem="{Binding CategoriaFiltroSeleccionada}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tipo de venta" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource FilterBox}" ItemsSource="{Binding TiposVentaFiltro}"
                                          SelectedItem="{Binding TipoVentaFiltroSeleccionado}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Estado" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource FilterBox}" ItemsSource="{Binding EstadosFiltro}"
                                          SelectedItem="{Binding EstadoFiltroSeleccionado}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="White" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="16,13,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Lista de productos" FontSize="16" FontWeight="Bold" Foreground="#17365D" VerticalAlignment="Center"/>
                            <WrapPanel Grid.Column="1">
                                <Button Content="+ Nuevo producto" Style="{StaticResource PrimaryButton}" Margin="0,0,7,0"
                                        Command="{Binding AbrirModalNuevoCommand}"/>
                                <Button Content="Desactivar" Style="{StaticResource DangerButton}" Margin="0,0,7,0"
                                        Visibility="{Binding AccionesProductoActivoVisible}" Command="{Binding EliminarCommand}"/>
                                <Button Content="Reactivar" Style="{StaticResource SuccessButton}" Margin="0,0,7,0"
                                        Visibility="{Binding AccionesProductoInactivoVisible}" Command="{Binding ReactivarCommand}"/>
                                <Button Content="Historial general" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding VerHistorialGeneralCommand}"/>
                            </WrapPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" Margin="0,0,0,6" ItemsSource="{Binding Productos}"
                                  SelectedItem="{Binding ProductoSeleccionado, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column" BorderThickness="0"
                                  GridLinesVisibility="Horizontal" RowHeight="43" ColumnHeaderHeight="40"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#526B8E"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="7,0"/>
                                    <Setter Property="BorderBrush" Value="#E0E7F0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="BorderBrush" Value="#EDF1F6"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#EDF1F6"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FBFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E9F3FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="34">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
                                                      IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" ElementStyle="{StaticResource GridText}" Width="1.2*"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" ElementStyle="{StaticResource GridText}" Width="2.15*"/>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria.Nombre}" ElementStyle="{StaticResource GridText}" Width="1.4*"/>
                                <DataGridTextColumn Header="Tipo de venta" Binding="{Binding UnidadVenta}" ElementStyle="{StaticResource GridText}" Width="1.12*"/>
                                <DataGridTextColumn Header="Precio (S/)" Binding="{Binding PrecioVenta, StringFormat={}{0:F2}}" ElementStyle="{StaticResource GridText}" Width="1.05*"/>
                                <DataGridTemplateColumn Header="Estado" Width="1.15*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                <Setter Property="Background" Value="#F3E8FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Activo"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                    <Setter Property="Text" Value="Desactivado"/>
                                                                    <Setter Property="Foreground" Value="#6B21A8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="2" Margin="16,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ProductosMostrados, StringFormat=Mostrando {0} productos}" Foreground="#526B8E" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalProductos, StringFormat=de {0} registrados}" Foreground="#526B8E" FontSize="11"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Resumen de productos" FontSize="15" FontWeight="Bold" Foreground="#17365D"/>
                        <UniformGrid Grid.Row="2" Columns="4" Height="112" VerticalAlignment="Top">
                            <Border Margin="0,0,6,0" Background="#FBFCFE" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="6" Padding="7">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="23" Height="23" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M4,4 L20,4 L20,20 L4,20 Z M4,10 L20,10 M12,4 L12,20" Stroke="#2377E8" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding TotalProductos}" FontSize="19" FontWeight="Bold" Foreground="#17365D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="Total" FontSize="10" Foreground="#526B8E" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,6,0" Background="#FBFCFE" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="6" Padding="7">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="23" Height="23" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M4,4 L20,4 L20,20 L4,20 Z M8,12 L11,15 L17,9" Stroke="#16A34A" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding TotalProductosActivos}" FontSize="19" FontWeight="Bold" Foreground="#17365D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="Activos" FontSize="10" Foreground="#526B8E" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,6,0" Background="#FBFCFE" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="6" Padding="7">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="23" Height="23" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M4,4 L20,4 L20,20 L4,20 Z M8,8 L16,16 M16,8 L8,16" Stroke="#D97706" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding TotalProductosInactivos}" FontSize="19" FontWeight="Bold" Foreground="#17365D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="Inactivos" FontSize="10" Foreground="#526B8E" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FBFCFE" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="6" Padding="7">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="23" Height="23" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M12,3 L22,21 L2,21 Z M12,9 L12,14 M12,17 L12,17" Stroke="#7C3AED" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding ProductosConStockBajo}" FontSize="19" FontWeight="Bold" Foreground="#17365D" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="Stock bajo" FontSize="10" Foreground="#526B8E" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="White" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TituloFormulario}" FontSize="16" FontWeight="Bold" Foreground="#17365D" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Historial del producto" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0"
                                    Command="{Binding VerHistorialProductoCommand}"/>
                        </Grid>

                        <StackPanel Grid.Row="2" IsEnabled="{Binding FormularioHabilitado}">
                            <TextBlock Text="Nombre del producto" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Style="{StaticResource FilterBox}" ItemsSource="{Binding CategoriasDisponibles}"
                                                      SelectedItem="{Binding CategoriaSeleccionada}" DisplayMemberPath="Nombre"/>
                                        <Button Grid.Column="2" Content="+" Style="{StaticResource SuccessButton}" Height="38" Padding="0"
                                                    FontSize="20" Command="{Binding AbrirModalNuevaCategoriaCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tipo de venta" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Style="{StaticResource FilterBox}" ItemsSource="{Binding UnidadesVenta}"
                                                  SelectedItem="{Binding UnidadVenta}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Precio de venta (S/)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtPrecioVenta" Style="{StaticResource InputBox}" HorizontalContentAlignment="Right"
                                                 Text="{Binding PrecioVenta, Converter={StaticResource DecimalFlexibleConverter}, ConverterParameter=2, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Stock mínimo" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource InputBox}" HorizontalContentAlignment="Right"
                                                 Text="{Binding StockMinimo, Converter={StaticResource DecimalFlexibleConverter}, ConverterParameter=2, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Código de barras" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <TextBox x:Name="TxtCodigoBarras" Style="{StaticResource InputBox}"
                                         PreviewTextInput="TxtCodigoBarras_PreviewTextInput"
                                         PreviewKeyDown="TxtCodigoBarras_PreviewKeyDown"
                                         KeyDown="TxtCodigoBarras_KeyDown" ContextMenu="{x:Null}"
                                         Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}"/>
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding StockActual, StringFormat=Stock actual: {0:0.##}}" Foreground="#1E3A5F" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Se actualiza desde Abastecimiento y movimientos de inventario."
                                                   Foreground="#526B8E" FontSize="10.5" Margin="0,2,0,0" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Width="95" Margin="0,0,9,0"
                                    Command="{Binding AbrirModalNuevoCommand}"/>
                            <Button Content="{Binding TextoAccionFormulario}" Style="{StaticResource PrimaryButton}" Width="105"
                                    IsEnabled="{Binding FormularioHabilitado}" Command="{Binding GuardarCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <!-- Historial general de productos -->
        <Border Background="#990F172A" Visibility="{Binding ModalHistorialGeneralVisible}" Panel.ZIndex="11">
            <Border Background="White" BorderBrush="#D8E0EB" BorderThickness="1" CornerRadius="12" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" MaxHeight="600">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Historial general de productos" FontSize="23" FontWeight="Bold" Foreground="#17365D"/>
                    <TextBlock Grid.Row="1" Text="Cambios de precios, desactivaciones y reactivaciones registrados en la bodega."
                               Foreground="#64748B" Margin="0,5,0,18" TextWrapping="Wrap"/>
                    <Border Grid.Row="2" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="6">
                        <DataGrid ItemsSource="{Binding HistorialGeneralProductos}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  RowHeight="42" ColumnHeaderHeight="40">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#526B8E"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="BorderBrush" Value="#EDF1F6"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora, StringFormat={}{0:dd/MM/yyyy HH:mm}}" ElementStyle="{StaticResource GridText}" Width="1.35*"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" ElementStyle="{StaticResource GridText}" Width="1.5*"/>
                                <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" ElementStyle="{StaticResource GridText}" Width="1.35*"/>
                                <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" ElementStyle="{StaticResource GridText}" Width="2.5*"/>
                                <DataGridTextColumn Header="Registrado por" Binding="{Binding UsuarioNombre}" ElementStyle="{StaticResource GridText}" Width="1.45*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Button Grid.Row="3" Content="Cerrar" Style="{StaticResource PrimaryButton}" Width="102"
                            HorizontalAlignment="Right" Margin="0,18,0,0" Command="{Binding CerrarModalHistorialGeneralCommand}"/>
                </Grid>
            </Border>
        </Border>

        <!-- Historial del producto -->
        <Border Background="#990F172A" Visibility="{Binding ModalHistorialPreciosVisible}" Panel.ZIndex="11">
            <Border Background="White" BorderBrush="#D8E0EB" BorderThickness="1" CornerRadius="12" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" MaxHeight="560">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Historial del producto" FontSize="23" FontWeight="Bold" Foreground="#17365D"/>
                    <TextBlock Grid.Row="1" Text="{Binding NombreProductoHistorial}" Foreground="#64748B" Margin="0,5,0,18"/>
                    <Border Grid.Row="2" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="6">
                        <DataGrid ItemsSource="{Binding HistorialProducto}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  RowHeight="42" ColumnHeaderHeight="40">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#526B8E"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,0"/>
                                    <Setter Property="BorderBrush" Value="#EDF1F6"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora, StringFormat={}{0:dd/MM/yyyy HH:mm}}" ElementStyle="{StaticResource GridText}" Width="1.5*"/>
                                <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" ElementStyle="{StaticResource GridText}" Width="1.5*"/>
                                <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" ElementStyle="{StaticResource GridText}" Width="2.7*"/>
                                <DataGridTextColumn Header="Registrado por" Binding="{Binding UsuarioNombre}" ElementStyle="{StaticResource GridText}" Width="1.7*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Button Grid.Row="3" Content="Cerrar" Style="{StaticResource PrimaryButton}" Width="102"
                            HorizontalAlignment="Right" Margin="0,18,0,0" Command="{Binding CerrarModalHistorialPreciosCommand}"/>
                </Grid>
            </Border>
        </Border>

        <!-- Nueva categoría -->
        <Border Background="#990F172A" Visibility="{Binding ModalCategoriaVisible}" Panel.ZIndex="12">
            <Border Background="White" BorderBrush="#D8E0EB" BorderThickness="1" CornerRadius="12" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="410">
                <StackPanel>
                    <TextBlock Text="Nueva categoría" FontSize="22" FontWeight="Bold" Foreground="#17365D"/>
                    <TextBlock Text="Nombre de la categoría" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding NuevaCategoriaNombre, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Width="98" Margin="0,0,10,0"
                                Command="{Binding CerrarModalCategoriaCommand}"/>
                        <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Width="98"
                                Command="{Binding GuardarNuevaCategoriaCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Confirmación de desactivación -->
        <Border Background="#990F172A" Visibility="{Binding ModalConfirmarDesactivacionVisible}" Panel.ZIndex="13">
            <Border Background="White" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="12" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
                <StackPanel>
                    <TextBlock Text="Desactivar producto" FontSize="23" FontWeight="Bold" Foreground="#991B1B"/>
                    <TextBlock Text="{Binding ProductoSeleccionado.Nombre}" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,12,0,0"/>
                    <TextBlock Text="Dejará de estar disponible para nuevas operaciones. Sus precios y movimientos se conservarán."
                               Foreground="#64748B" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,18,0,0">
                        <TextBlock Text="Luego podrás consultarlo y reactivarlo filtrando por estado “Desactivados”."
                                   Foreground="#991B1B" FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0"
                                Command="{Binding CancelarDesactivacionCommand}"/>
                        <Button Content="Desactivar" Style="{StaticResource DangerButton}" Width="110"
                                Command="{Binding ConfirmarDesactivacionCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Confirmación de reactivación -->
        <Border Background="#990F172A" Visibility="{Binding ModalConfirmarReactivacionVisible}" Panel.ZIndex="13">
            <Border Background="White" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
                <StackPanel>
                    <TextBlock Text="Reactivar producto" FontSize="23" FontWeight="Bold" Foreground="#065F46"/>
                    <TextBlock Text="{Binding ProductoSeleccionado.Nombre}" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,12,0,0"/>
                    <TextBlock Text="El producto volverá a estar disponible para las nuevas operaciones."
                               Foreground="#64748B" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,18,0,0">
                        <TextBlock Text="La reactivación también quedará registrada en su historial."
                                   Foreground="#065F46" FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0"
                                Command="{Binding CancelarReactivacionCommand}"/>
                        <Button Content="Reactivar" Style="{StaticResource SuccessButton}" Width="110"
                                Command="{Binding ConfirmarReactivacionCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Panel.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="7" Padding="18,13"
                Visibility="{Binding IsNotificacionVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.12" ShadowDepth="2"/>
            </Border.Effect>
            <TextBlock Text="{Binding MensajeNotificacion}" FontSize="14" Foreground="#065F46" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="BodegaLuchito.Desktop.Modules.Caja.Views.Estados.AperturaCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controles="clr-namespace:BodegaLuchito.Desktop.Modules.Caja.Views.Controles"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="430">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="../../Resources/CajaStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="0.6*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource Tarjeta}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="50"
                        Height="50"
                        CornerRadius="10"
                        HorizontalAlignment="Left"
                        Background="{StaticResource ColorAcentoClaro}"
                        Margin="0,0,0,16">
                    <TextBlock Text="S/"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorAcento}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Iniciar jornada de caja"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorTextoPrincipal}" />
                    <TextBlock
                        Text="Registra el efectivo disponible antes de comenzar las operaciones."
                        FontSize="13"
                        Foreground="{StaticResource ColorTextoSecundario}"
                        TextWrapping="Wrap"
                        Margin="0,6,0,20" />
                </StackPanel>

                <StackPanel Grid.Row="2"
                            MaxWidth="420"
                            HorizontalAlignment="Left">
                    <controles:CampoEntrada
                        Etiqueta="Fondo inicial (S/)"
                        Valor="{Binding FondoInicialInput}" />
                    <TextBlock
                        Text="Ingresa el dinero físico con el que comenzará la caja."
                        FontSize="12"
                        Foreground="{StaticResource ColorTextoSecundario}"
                        Margin="2,-7,0,18" />
                </StackPanel>

                <Button Grid.Row="3"
                        Content="Abrir caja"
                        Command="{Binding AbrirCajaCommand}"
                        Style="{StaticResource BotonPrimario}"
                        Width="170"
                        HorizontalAlignment="Left" />
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource Tarjeta}">
            <StackPanel>
                <TextBlock Text="Antes de comenzar"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorTextoPrincipal}"
                           Margin="0,0,0,20" />
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="{StaticResource ColorAcentoClaro}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="1"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ColorAcento}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="Cuenta el efectivo disponible."
                               FontSize="13"
                               Foreground="{StaticResource ColorTextoSecundario}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="{StaticResource ColorAcentoClaro}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="2"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ColorAcento}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="Registra el monto como fondo inicial."
                               FontSize="13"
                               Foreground="{StaticResource ColorTextoSecundario}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>
                    <Border Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="{StaticResource ColorAcentoClaro}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="3"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ColorAcento}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="Abre la caja e inicia la jornada."
                               FontSize="13"
                               Foreground="{StaticResource ColorTextoSecundario}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

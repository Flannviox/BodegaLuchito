<UserControl x:Class="BodegaLuchito.Desktop.Modules.Ventas.Views.VentasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pago="clr-namespace:BodegaLuchito.Domain.Shared.Enums;assembly=BodegaLuchito.Domain"
    xmlns:conv="clr-namespace:BodegaLuchito.Desktop.Modules.Ventas.Converters"
    Background="#F4F7FB" Foreground="#17365D" FontSize="13" Language="es-PE" IsEnabled="{Binding PuedeInteractuar}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/VentasStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible"/>
            <conv:VentaCompactaConverter x:Key="Compacta"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Nueva venta" Command="{Binding MostrarNuevaVentaCommand}" Margin="0,0,8,0" Padding="20,10">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VentaSecundario}"><Style.Triggers>
                    <DataTrigger Binding="{Binding IsNuevaVentaVisible}" Value="True"><Setter Property="Background" Value="#1767D8"/><Setter Property="Foreground" Value="White"/></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1C5799"/><Setter Property="Foreground" Value="White"/></Trigger>
                </Style.Triggers></Style></Button.Style>
            </Button>
            <Button Content="Historial de ventas" Command="{Binding MostrarHistorialCommand}" Padding="20,10">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VentaSecundario}"><Style.Triggers>
                    <DataTrigger Binding="{Binding IsHistorialVisible}" Value="True"><Setter Property="Background" Value="#1767D8"/><Setter Property="Foreground" Value="White"/></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1C5799"/><Setter Property="Foreground" Value="White"/></Trigger>
                </Style.Triggers></Style></Button.Style>
            </Button>
        </StackPanel>

        <Grid x:Name="DisposicionVenta" Grid.Row="1" Visibility="{Binding IsNuevaVentaVisible, Converter={StaticResource Visible}}"
              Tag="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource Compacta}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="340"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DisposicionVenta}" Value="True"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers>
                </Style></ColumnDefinition.Style></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource VentaTarjeta}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Buscar o escanear un producto" FontSize="16" FontWeight="SemiBold"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="BuscadorTextBox" Style="{StaticResource VentaEntrada}" Height="44" FontSize="15"
                                 Text="{Binding TextoBusquedaProducto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar producto o código de barras">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AgregarAlCarritoManualCommand}"/></TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Escribe el nombre o escanea el código…" Foreground="#6B7E95" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding TextoBusquedaProducto}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Content="Limpiar" Style="{StaticResource VentaSecundario}" Command="{Binding LimpiarBusquedaCommand}" Margin="8,0,0,0"/>
                        <Popup IsOpen="{Binding IsDropdownOpen}" PlacementTarget="{Binding ElementName=BuscadorTextBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=BuscadorTextBox}">
                            <Border Style="{StaticResource VentaTarjeta}" Padding="0" Margin="0,3,0,0">
                                <DataGrid Style="{StaticResource VentaTabla}" ItemsSource="{Binding ProductosFiltrados}" SelectedItem="{Binding ProductoSeleccionado}" MaxHeight="260" MinRowHeight="56">
                                    <DataGrid.RowStyle><Style TargetType="DataGridRow">
                                        <Setter Property="Cursor" Value="Hand"/><EventSetter Event="MouseLeftButtonUp" Handler="FilaProducto_MouseLeftButtonUp"/>
                                        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EAF2FF"/></Trigger></Style.Triggers>
                                    </Style></DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Producto" Width="*" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CodigoBarras}" Foreground="#617791" FontSize="11"/>
                                        </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Disponible" Binding="{Binding StockActual, StringFormat={}{0:0.###}}" Width="85" ElementStyle="{StaticResource VentaTextoCelda}"/>
                                        <DataGridTextColumn Header="Precio" Binding="{Binding PrecioVenta, StringFormat=S/ {0:N2}}" Width="95" ElementStyle="{StaticResource VentaTextoCelda}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock Text="Elige un resultado para añadirlo. Si es por peso, escribe la cantidad en kilos." Foreground="#617791" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource VentaTarjeta}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Productos de esta venta" FontSize="16" FontWeight="SemiBold" Margin="16,14"/>
                    <DataGrid x:Name="TablaCarrito" Grid.Row="1" Style="{StaticResource VentaTabla}" ItemsSource="{Binding Carrito}" MinRowHeight="68">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Producto" Width="*" MinWidth="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
                                <TextBlock Text="{Binding Nombre}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CodigoBarras}" FontSize="11" Foreground="#617791" Margin="0,3,0,0"/>
                            </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Precio" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
                                <TextBlock Text="{Binding PrecioUnitario, StringFormat=S/ {0:N2}}"/>
                                <TextBlock Foreground="#617791" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="por unidad"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding UnidadVenta}" Value="Peso"><Setter Property="Text" Value="por kg"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style></TextBlock>
                            </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cantidad" Width="168"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" Style="{StaticResource VentaSecundario}" Padding="0" MinHeight="32" Width="30" Height="32" Command="{Binding DataContext.RestarCantidadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="Reducir cantidad"/>
                                    <TextBox Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VentaEntrada}" MinHeight="32" Height="32" Width="66" Padding="2" TextAlignment="Center" Margin="4,0" AutomationProperties.Name="Cantidad del producto"/>
                                    <Button Content="+" Style="{StaticResource VentaSecundario}" Padding="0" MinHeight="32" Width="30" Height="32" Command="{Binding DataContext.SumarCantidadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="Aumentar cantidad"/>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Center" Foreground="#617791" FontSize="11" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="unidades"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding UnidadVenta}" Value="Peso"><Setter Property="Text" Value="kilogramos"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style></TextBlock>
                            </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Importe" Binding="{Binding Subtotal, Mode=OneWay, StringFormat=S/ {0:N2}}" Width="100" FontWeight="SemiBold" ElementStyle="{StaticResource VentaTextoCelda}"/>
                            <DataGridTemplateColumn Header="" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Content="Quitar" Style="{StaticResource VentaPeligro}" Padding="8,5" MinHeight="32" Command="{Binding DataContext.QuitarDelCarritoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="20,45,20,12">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Carrito.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="Tu venta empieza aquí" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Busca un producto para añadirlo a la lista." Foreground="#617791" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="2" BorderBrush="#E8EEF6" BorderThickness="0,1,0,0" Padding="16,10">
                        <TextBlock Text="{Binding Carrito.Count, StringFormat=Productos diferentes: {0}}" Foreground="#617791" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style><Style TargetType="ScrollViewer">
                    <Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.RowSpan" Value="2"/>
                    <Setter Property="Margin" Value="14,0,0,0"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=DisposicionVenta}" Value="True">
                        <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="2"/><Setter Property="Grid.RowSpan" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/>
                        <Setter Property="Margin" Value="0,12,0,0"/><Setter Property="MaxHeight" Value="270"/>
                    </DataTrigger></Style.Triggers>
                </Style></ScrollViewer.Style>
                <StackPanel>
                    <Border Style="{StaticResource VentaTarjeta}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="Resumen de la venta" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <DockPanel Margin="0,0,0,8"><TextBlock Text="Productos diferentes" Foreground="#617791"/><TextBlock Text="{Binding Carrito.Count}" TextAlignment="Right"/></DockPanel>
                        <DockPanel Margin="0,0,0,8"><TextBlock Text="Subtotal" Foreground="#617791"/><TextBlock Text="{Binding SubtotalVenta, StringFormat=S/ {0:N2}}" TextAlignment="Right"/></DockPanel>
                        <DockPanel><TextBlock Text="IGV (18%)" Foreground="#617791"/><TextBlock Text="{Binding IgvVenta, StringFormat=S/ {0:N2}}" TextAlignment="Right"/></DockPanel>
                        <Border BorderBrush="#E3EBF5" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0"><StackPanel>
                            <TextBlock Text="TOTAL A COBRAR" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalVenta, StringFormat=S/ {0:N2}}" FontSize="32" FontWeight="Bold" Foreground="#1767D8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel></Border>
                    </StackPanel></Border>
                    <Border Style="{StaticResource VentaTarjeta}"><StackPanel>
                        <TextBlock Text="Método de pago" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <UniformGrid Columns="3">
                            <Button Command="{Binding SeleccionarMedioCobroCommand}" CommandParameter="{x:Static pago:MetodoPago.Efectivo}" Margin="3,0" Padding="5,10" AutomationProperties.Name="Pagar con Efectivo">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VentaSecundario}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding MedioCobro}" Value="Efectivo"><Setter Property="Background" Value="#EAF3FF"/><Setter Property="BorderBrush" Value="#1767D8"/><Setter Property="Foreground" Value="#174475"/></DataTrigger>
                                </Style.Triggers></Style></Button.Style>
                                <StackPanel><Path Data="M 2,5 L 22,5 L 22,19 L 2,19 Z M 9,12 A 3,3 0 1 0 15,12 A 3,3 0 1 0 9,12 M 5,9 L 5,15 M 19,9 L 19,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="25" Height="25" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="Efectivo" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                            <Button Command="{Binding SeleccionarMedioCobroCommand}" CommandParameter="{x:Static pago:MetodoPago.Yape}" Margin="3,0" Padding="5,10" AutomationProperties.Name="Pagar con Yape">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VentaSecundario}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding MedioCobro}" Value="Yape"><Setter Property="Background" Value="#EAF3FF"/><Setter Property="BorderBrush" Value="#1767D8"/><Setter Property="Foreground" Value="#174475"/></DataTrigger>
                                </Style.Triggers></Style></Button.Style>
                                <StackPanel><Path Data="M 7,2 L 17,2 L 17,22 L 7,22 Z M 10,5 L 14,5 M 11,19 L 13,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="25" Height="25" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="Yape" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                            <Button Command="{Binding SeleccionarMedioCobroCommand}" CommandParameter="{x:Static pago:MetodoPago.Plin}" Margin="3,0" Padding="5,10" AutomationProperties.Name="Pagar con Plin">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VentaSecundario}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding MedioCobro}" Value="Plin"><Setter Property="Background" Value="#EAF3FF"/><Setter Property="BorderBrush" Value="#1767D8"/><Setter Property="Foreground" Value="#174475"/></DataTrigger>
                                </Style.Triggers></Style></Button.Style>
                                <StackPanel><Path Data="M 7,2 L 17,2 L 17,22 L 7,22 Z M 10,5 L 14,5 M 11,19 L 13,19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="25" Height="25" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="Plin" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                        </UniformGrid>
                        <StackPanel Visibility="{Binding EsEfectivo, Converter={StaticResource Visible}}" Margin="0,18,0,0">
                            <TextBlock Text="Monto recibido (S/)" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MontoRecibidoTexto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VentaEntrada}" FontSize="21" Height="44" MaxLength="16" AutomationProperties.Name="Monto recibido en efectivo"/>
                                <Button Grid.Column="1" Content="Exacto" Command="{Binding ImporteExactoCommand}" Style="{StaticResource VentaSecundario}" Margin="8,0,0,0" Padding="10,6"/>
                            </Grid>
                            <Border Background="#E6F7F1" CornerRadius="7" Padding="12" Margin="0,12,0,0"><StackPanel>
                                <TextBlock Text="Vuelto a entregar" Foreground="#076B54"/>
                                <TextBlock Text="{Binding Vuelto, StringFormat=S/ {0:N2}}" Foreground="#076B54" FontSize="26" FontWeight="Bold"/>
                            </StackPanel></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding MensajeCobro}" TextWrapping="Wrap" Foreground="#617791" Margin="0,12,0,14"/>
                        <Button Content="Confirmar venta" Command="{Binding ConfirmarCobroCommand}" MinHeight="48">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VentaBoton}"><Setter Property="Background" Value="#078268"/><Setter Property="BorderBrush" Value="#078268"/>
                                <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#E8EDF4"/><Setter Property="BorderBrush" Value="#D8E2EE"/></Trigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource VentaTarjeta}" Padding="0" Visibility="{Binding IsHistorialVisible, Converter={StaticResource Visible}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="16,14">
                    <TextBlock Text="Ventas registradas" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Las ventas anuladas se conservan para consulta. Selecciona una para ver el motivo." Foreground="#617791" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <!-- Filtro por fecha -->
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center">
                            <TextBlock Text="Desde" VerticalAlignment="Center" Foreground="#617791" Margin="0,0,8,0"/>
                            <DatePicker Width="140" Height="34" VerticalContentAlignment="Center" SelectedDate="{Binding FiltroDesde}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center">
                            <TextBlock Text="Hasta" VerticalAlignment="Center" Foreground="#617791" Margin="0,0,8,0"/>
                            <DatePicker Width="140" Height="34" VerticalContentAlignment="Center" SelectedDate="{Binding FiltroHasta}"/>
                        </StackPanel>
                        <Button Content="Buscar" Style="{StaticResource VentaBoton}" Padding="16,6" MinHeight="34" Margin="0,0,8,6" Command="{Binding FiltrarHistorialCommand}"/>
                        <Button Content="Hoy" Style="{StaticResource VentaSecundario}" Padding="14,6" MinHeight="34" Margin="0,0,8,6" Command="{Binding FiltrarHoyCommand}"/>
                        <Button Content="Ver todas" Style="{StaticResource VentaSecundario}" Padding="14,6" MinHeight="34" Margin="0,0,8,6" Command="{Binding LimpiarFiltroHistorialCommand}"/>
                    </WrapPanel>
                </StackPanel>
                <DataGrid x:Name="TablaHistorial" Grid.Row="1" Style="{StaticResource VentaTabla}" ItemsSource="{Binding HistorialVentas}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ticket" Binding="{Binding Id, StringFormat=Venta #{0}}" Width="90" ElementStyle="{StaticResource VentaTextoCelda}"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}" Width="142" ElementStyle="{StaticResource VentaTextoCelda}"/>
                        <DataGridTextColumn Header="Atendió" Binding="{Binding Usuario.NombreCompleto}" Width="*" MinWidth="130" ElementStyle="{StaticResource VentaTextoCelda}"/>
                        <DataGridTextColumn Header="Pago" Binding="{Binding MetodoPago}" Width="85" ElementStyle="{StaticResource VentaTextoCelda}"/>
                        <DataGridTextColumn Header="Importe" Binding="{Binding Total, StringFormat=S/ {0:N2}}" Width="100">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource VentaTextoCelda}"><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers>
                                <DataTrigger Binding="{Binding Anulado}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger>
                            </Style.Triggers></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Estado" Width="112"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <Border CornerRadius="5" Padding="8,5" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E9F5EF"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Anulado}" Value="True"><Setter Property="Background" Value="#FEE4E2"/></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Completada"/><Setter Property="Foreground" Value="#166448"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Anulado}" Value="True"><Setter Property="Text" Value="Anulada"/><Setter Property="Foreground" Value="#A5231A"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style></TextBlock>
                            </Border>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Acciones" Width="182"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                            <Button Content="Ver ticket" Style="{StaticResource VentaSecundario}" Padding="9,6" MinHeight="34" Command="{Binding DataContext.VerDetallesVentaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                            <Button Content="Anular" Padding="9,6" MinHeight="34" Margin="6,0,0,0" Command="{Binding DataContext.AnularVentaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VentaPeligro}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding EsTurnoActual}" Value="True"/><Condition Binding="{Binding Anulado}" Value="False"/>
                                </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                        </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#617791">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Text" Value="Aún no hay ventas registradas."/><Style.Triggers>
                        <DataTrigger Binding="{Binding HistorialVentas.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding HayFiltroSinResultados}" Value="True"><Setter Property="Text" Value="No hay ventas en las fechas elegidas."/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Row="2" Margin="16,10">
                    <Border Background="#FFF2F0" BorderBrush="#F3CEC9" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.Anulado, ElementName=TablaHistorial}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="{Binding SelectedItem.Id, ElementName=TablaHistorial, StringFormat=Venta #{0} · Anulada}" FontWeight="SemiBold" Foreground="#A5231A"/>
                            <TextBlock Text="{Binding SelectedItem.MotivoAnulacion, ElementName=TablaHistorial, StringFormat=Motivo: {0}, TargetNullValue=Motivo no registrado}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding SelectedItem.FechaAnulacion, ElementName=TablaHistorial, StringFormat=Anulada el {0:dd/MM/yyyy HH:mm}, TargetNullValue=Fecha de anulación no registrada}" Foreground="#617791" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel></ScrollViewer>
                    </Border>
                    <!-- Paginación -->
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TextoRango}" Foreground="#617791" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="«" ToolTip="Primera página" AutomationProperties.Name="Primera página" Style="{StaticResource VentaSecundario}" Padding="0" Width="36" MinHeight="34" Height="34" Command="{Binding PrimeraPaginaCommand}"/>
                            <Button Content="‹ Anterior" Style="{StaticResource VentaSecundario}" Padding="12,6" MinHeight="34" Margin="6,0,0,0" Command="{Binding PaginaAnteriorCommand}"/>
                            <TextBlock Text="{Binding TextoPagina}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="14,0"/>
                            <Button Content="Siguiente ›" Style="{StaticResource VentaSecundario}" Padding="12,6" MinHeight="34" Command="{Binding PaginaSiguienteCommand}"/>
                            <Button Content="»" ToolTip="Última página" AutomationProperties.Name="Última página" Style="{StaticResource VentaSecundario}" Padding="0" Width="36" MinHeight="34" Height="34" Margin="6,0,0,0" Command="{Binding UltimaPaginaCommand}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.RowSpan="2" Panel.ZIndex="20" Background="#EAF3FF" BorderBrush="#B6D4FA" BorderThickness="1" CornerRadius="8" Padding="14"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="450" Margin="16" IsHitTestVisible="False" Visibility="{Binding IsSnackbarActive, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding MensajeSnackbar}" TextWrapping="Wrap" Foreground="#174475"/>
        </Border>
    </Grid>
</UserControl>

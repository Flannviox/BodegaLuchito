<UserControl x:Class="BodegaLuchito.Desktop.Modules.BI.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
 Background="#F4F7FB" Language="es-PE" FontFamily="Segoe UI">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/BodegaLuchito.Desktop;component/Resources/PanelComercialStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="Tu bodega de un vistazo" FontSize="24" FontWeight="SemiBold" Foreground="#173657"/>
 <TextBlock Style="{StaticResource PanelMuted}" Text="{Binding UltimaActualizacion, FallbackValue='Ventas, pagos e inventario en un solo lugar.'}" Margin="0,6,12,0"/></StackPanel>
 <Button Grid.Column="1" Style="{StaticResource PanelOutlineButton}" Command="{Binding CargarDashboardCommand}" VerticalAlignment="Center" AutomationProperties.Name="Actualizar indicadores">
 <StackPanel Orientation="Horizontal"><Path Style="{StaticResource PanelIcon}" Data="{StaticResource IconRefresh}" Stroke="#1767D8"/><TextBlock Text="Actualizar" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button></Grid>
 <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="14" Margin="0,0,0,18"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Button Style="{StaticResource PanelOutlineButton}" Command="{Binding MesAnteriorCommand}" Content="‹" FontSize="20" Padding="14,4" ToolTip="Mes anterior" AutomationProperties.Name="Mes anterior"/>
 <TextBlock Grid.Column="1" Text="{Binding MesSeleccionadoTexto}" Foreground="#173657" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="160" TextAlignment="Center" Margin="8,0"/>
 <Button Grid.Column="2" Style="{StaticResource PanelOutlineButton}" Command="{Binding MesSiguienteCommand}" Content="›" FontSize="20" Padding="14,4" ToolTip="Mes siguiente" AutomationProperties.Name="Mes siguiente"/>
 <Button Grid.Column="4" Style="{StaticResource PanelOutlineButton}" Command="{Binding MesActualCommand}" Content="Mes actual"/>
 <TextBlock Grid.Column="5" Text="{Binding PeriodoTexto}" Style="{StaticResource PanelMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
 </Grid></Border>
 <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,18">
 <Border Style="{StaticResource PanelCard}" Margin="0,0,12,0" Padding="18">
    <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding TituloDia}" Foreground="#52657E" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
    <Border Grid.Column="1" Background="#EAF2FF" CornerRadius="9" Width="36" Height="36"><Path Style="{StaticResource PanelIcon}" Data="{StaticResource IconSales}" Stroke="#1767D8"/></Border></Grid>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Style="{StaticResource PanelMoney}" Text="{Binding Datos.VentasDelDia.TotalMonto, StringFormat=S/ {0:N2}, FallbackValue='S/ 0.00'}"/></Viewbox>
    <TextBlock Style="{StaticResource PanelMuted}" Text="{Binding VariacionDiaTexto}"/></StackPanel>
</Border>
 <Border Style="{StaticResource PanelCard}" Margin="0,0,12,0" Padding="18">
    <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Ventas del mes" Foreground="#52657E" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
    <Border Grid.Column="1" Background="#E6F7F1" CornerRadius="9" Width="36" Height="36"><Path Style="{StaticResource PanelIcon}" Data="{StaticResource IconTrend}" Stroke="#078268"/></Border></Grid>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Style="{StaticResource PanelMoney}" Text="{Binding Datos.VentasDelMes.TotalMonto, StringFormat=S/ {0:N2}, FallbackValue='S/ 0.00'}"/></Viewbox>
    <TextBlock Style="{StaticResource PanelMuted}" Text="{Binding VariacionMesTexto}"/></StackPanel>
</Border>
 <Border Style="{StaticResource PanelCard}" Margin="0,0,12,0" Padding="18">
    <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Tickets del mes" Foreground="#52657E" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
    <Border Grid.Column="1" Background="#F1ECFB" CornerRadius="9" Width="36" Height="36"><Path Style="{StaticResource PanelIcon}" Data="{StaticResource IconTicket}" Stroke="#7853C5"/></Border></Grid>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Style="{StaticResource PanelMoney}" Text="{Binding Datos.VentasDelMes.CantidadTransacciones, FallbackValue=0}"/></Viewbox>
    <TextBlock Style="{StaticResource PanelMuted}" Text="Ventas vigentes registradas"/></StackPanel>
</Border>
 <Border Style="{StaticResource PanelCard}" Margin="0" Padding="18">
    <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Diferencia de cierres" Foreground="#52657E" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
    <Border Grid.Column="1" Background="#FFF4E5" CornerRadius="9" Width="36" Height="36"><Path Style="{StaticResource PanelIcon}" Data="{StaticResource IconBalance}" Stroke="#B56B13"/></Border></Grid>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Style="{StaticResource PanelMoney}" Text="{Binding Datos.DiferenciaCajaDelDia, StringFormat=S/ {0:N2}, FallbackValue='S/ 0.00'}"/></Viewbox>
    <TextBlock Style="{StaticResource PanelMuted}" Text="Efectivo real menos esperado · mes"/></StackPanel>
</Border>
 </UniformGrid>
 <Grid Grid.Row="3" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource PanelCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="230"/></Grid.RowDefinitions>
 <TextBlock Style="{StaticResource PanelTitle}" Text="Evolución de ventas"/>
 <TextBlock Grid.Row="1" Style="{StaticResource PanelMuted}" Text="Ventas diarias del mes seleccionado · soles" Margin="0,5,0,16"/>
  <lvc:CartesianChart Grid.Row="2" Series="{Binding SerieEvolucionVentas}" XAxes="{Binding EjeX}" YAxes="{Binding EjeY}" TooltipPosition="Top" LegendPosition="Hidden">
 </lvc:CartesianChart>
 <Border Grid.Row="2" Background="White"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Datos.VentasDelMes.TotalMonto, FallbackValue=0}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="No hay ventas registradas en este mes." Style="{StaticResource PanelMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 </Grid></Border>
 <Border Grid.Column="2" Style="{StaticResource PanelCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Style="{StaticResource PanelTitle}" Text="Así pagan tus clientes"/>
 <TextBlock Grid.Row="1" Style="{StaticResource PanelMuted}" Text="Distribución de ventas del mes" Margin="0,5,0,10"/>
 <Grid Grid.Row="2">
 <lvc:PieChart Series="{Binding SerieMediosPago}" LegendPosition="Hidden"/>
 <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
 <TextBlock Text="TOTAL DEL MES" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
 <TextBlock Text="{Binding Datos.VentasDelMes.TotalMonto, StringFormat=S/ {0:N2}, FallbackValue='S/ 0.00'}" FontSize="15" FontWeight="SemiBold" Foreground="#173657" HorizontalAlignment="Center" Margin="0,4,0,0"/>
 </StackPanel></Grid>
 <ItemsControl Grid.Row="3" ItemsSource="{Binding Datos.MediosDePagoDelMes}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate>
 <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
 <Ellipse Width="7" Height="7" HorizontalAlignment="Left"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#078268"/><Style.Triggers>
 <DataTrigger Binding="{Binding MedioPago}" Value="Yape"><Setter Property="Fill" Value="#8B5CF6"/></DataTrigger>
 <DataTrigger Binding="{Binding MedioPago}" Value="Plin"><Setter Property="Fill" Value="#0EA5E9"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
 <TextBlock Grid.Column="1" Text="{Binding MedioPago}" FontSize="12" Foreground="#475569"/>
 <TextBlock Grid.Column="2" Text="{Binding TotalMonto, StringFormat=S/ {0:N2}}" FontSize="12" FontWeight="SemiBold" Foreground="#173657"/>
 <TextBlock Grid.Column="3" Text="{Binding PorcentajeDelTotal, StringFormat={}{0:N1}%}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
 </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Grid.Row="3" Text="Aún no hay pagos registrados este mes." Margin="0,15,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PanelMuted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Datos.MediosDePagoDelMes.Count, FallbackValue=0}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
 </TextBlock>
 </Grid></Border></Grid>
 <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource PanelCard}" Padding="14"><Grid>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="250"/></Grid.RowDefinitions>
 <TextBlock Text="Ventas por categoría" Style="{StaticResource PanelTitle}" FontSize="14"/>
 <TextBlock Grid.Row="1" Text="Top 6 por importe · mes seleccionado" Style="{StaticResource PanelMuted}" Margin="0,5,0,14"/>
  <lvc:CartesianChart Grid.Row="2" Series="{Binding SerieCategorias}" XAxes="{Binding EjeCategoriasX}" YAxes="{Binding EjeCategoriasY}" LegendPosition="Hidden">
 </lvc:CartesianChart>
 <Border Grid.Row="2" Background="White"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
 <Style.Triggers><DataTrigger Binding="{Binding Datos.VentasPorCategoria.Count, FallbackValue=0}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Aún no hay ventas por categoría." Style="{StaticResource PanelMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 </Grid></Border>
 <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="250"/></Grid.RowDefinitions>
 <TextBlock Style="{StaticResource PanelTitle}" Text="Productos más vendidos" FontSize="14"/>
 <TextBlock Grid.Row="1" Style="{StaticResource PanelMuted}" Text="Top 5 por importe · mes seleccionado" Margin="0,5,0,16"/>
 <Grid Grid.Row="2"><DataGrid Style="{StaticResource PanelTable}" FontSize="11" RowHeight="38" MinColumnWidth="48" ItemsSource="{Binding Datos.ProductosMasVendidosDelMes}"><DataGrid.Columns>
 <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
 <DataGridTextColumn Header="Importe" Binding="{Binding MontoTotalGenerado, StringFormat=S/ {0:N2}}" ElementStyle="{StaticResource PanelNumber}" Width="92"/>
 </DataGrid.Columns></DataGrid>
 <TextBlock Text="Las primeras ventas aparecerán aquí." HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PanelMuted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Datos.ProductosMasVendidosDelMes.Count, FallbackValue=0}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </Grid></Grid></Border>
 <Border Grid.Column="4" Style="{StaticResource PanelCard}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="250"/></Grid.RowDefinitions>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource PanelTitle}" Text="Stock bajo" FontSize="14"/>
 <Border Grid.Column="1" Background="#FFF4E5" CornerRadius="10" Padding="8,2"><TextBlock Text="{Binding Datos.ProductosConStockBajo.Count, FallbackValue=0}" Foreground="#9A5D15" FontWeight="SemiBold" FontSize="11"/></Border></Grid>
 <TextBlock Grid.Row="1" Style="{StaticResource PanelMuted}" Text="Inventario actual · en el mínimo o por debajo" Margin="0,5,0,16"/>
 <Grid Grid.Row="2"><DataGrid Style="{StaticResource PanelTable}" FontSize="11" RowHeight="38" MinColumnWidth="48" ItemsSource="{Binding Datos.ProductosConStockBajo}"><DataGrid.Columns>
 <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
 <DataGridTextColumn Header="Actual" Binding="{Binding StockActual, StringFormat={}{0:0.###}}" ElementStyle="{StaticResource PanelNumber}" Width="58"/>
 <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo, StringFormat={}{0:0.###}}" ElementStyle="{StaticResource PanelNumber}" Width="58"/>
 <DataGridTemplateColumn Header="Unidad" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="unid."/><Style.Triggers><DataTrigger Binding="{Binding UnidadVenta}" Value="Peso"><Setter Property="Text" Value="kg"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 </DataGrid.Columns></DataGrid>
 <TextBlock Text="No hay productos por reponer." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PanelMuted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Datos.ProductosConStockBajo.Count, FallbackValue=0}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </Grid></Grid></Border></Grid>
 </Grid></ScrollViewer>
</UserControl>

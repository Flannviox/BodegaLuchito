<UserControl x:Class="BodegaLuchito.Desktop.Modules.Reportes.Views.ReportesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F4F7FB" Language="es-PE" FontFamily="Segoe UI">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/BodegaLuchito.Desktop;component/Resources/PanelComercialStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <UserControl.InputBindings><KeyBinding Key="F2" Command="{Binding GenerarReporteCommand}"/><KeyBinding Key="F4" Command="{Binding ExportarExcelCommand}"/></UserControl.InputBindings>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,20"><TextBlock Text="Reportes comerciales" FontSize="24" FontWeight="SemiBold" Foreground="#173657"/>
 <TextBlock Style="{StaticResource PanelMuted}" Text="Consulta tus operaciones y lleva los resultados a Excel." Margin="0,6,0,0"/></StackPanel>
 <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
 <Border Style="{StaticResource PanelCard}" Margin="0,0,14,0" Padding="18">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#E6F7F1" Width="36" Height="36" VerticalAlignment="Top" CornerRadius="9"><Path Style="{StaticResource PanelIcon}" Data="{StaticResource IconTrend}" Stroke="#078268"/></Border>
<StackPanel Grid.Column="1"><TextBlock Text="Ventas del período" Foreground="#52657E" FontSize="12" FontWeight="SemiBold"/>
<Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Style="{StaticResource PanelMoney}" Text="{Binding TotalVentas, StringFormat=S/ {0:N2}}" Margin="0,7,0,5"/></Viewbox>
<TextBlock Style="{StaticResource PanelMuted}" Text="Sin ventas anuladas"/></StackPanel></Grid></Border>
 <Border Style="{StaticResource PanelCard}" Margin="0,0,14,0" Padding="18">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#FFF0ED" Width="36" Height="36" VerticalAlignment="Top" CornerRadius="9"><Path Style="{StaticResource PanelIcon}" Data="{StaticResource IconOutgoing}" Stroke="#B14F43"/></Border>
<StackPanel Grid.Column="1"><TextBlock Text="Pagos a proveedores" Foreground="#52657E" FontSize="12" FontWeight="SemiBold"/>
<Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Style="{StaticResource PanelMoney}" Text="{Binding TotalEgresos, StringFormat=S/ {0:N2}}" Margin="0,7,0,5"/></Viewbox>
<TextBlock Style="{StaticResource PanelMuted}" Text="Abastecimientos del período"/></StackPanel></Grid></Border>
 <Border Style="{StaticResource PanelCard}" Margin="0" Padding="18">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#FFF4E5" Width="36" Height="36" VerticalAlignment="Top" CornerRadius="9"><Path Style="{StaticResource PanelIcon}" Data="{StaticResource IconBalance}" Stroke="#B56B13"/></Border>
<StackPanel Grid.Column="1"><TextBlock Text="Diferencia de cierres" Foreground="#52657E" FontSize="12" FontWeight="SemiBold"/>
<Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Style="{StaticResource PanelMoney}" Text="{Binding DiferenciaCaja, StringFormat=S/ {0:N2}}" Margin="0,7,0,5"/></Viewbox>
<TextBlock Style="{StaticResource PanelMuted}" Text="Efectivo real menos esperado"/></StackPanel></Grid></Border>
 </UniformGrid>
 <Border Grid.Row="2" Style="{StaticResource PanelCard}" Margin="0,0,0,18"><Grid>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Path Style="{StaticResource PanelIcon}" Data="{StaticResource IconFilter}" Stroke="#1767D8"/><TextBlock Text="Filtrar información" Style="{StaticResource PanelTitle}" Margin="10,0,0,0"/></StackPanel>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="Desde" Style="{StaticResource PanelMuted}" Margin="0,0,0,6"/>
 <DatePicker Style="{StaticResource PanelDate}" SelectedDate="{Binding FechaInicio, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fecha inicial"/></StackPanel>
 <StackPanel Grid.Column="2"><TextBlock Text="Hasta" Style="{StaticResource PanelMuted}" Margin="0,0,0,6"/>
 <DatePicker Style="{StaticResource PanelDate}" SelectedDate="{Binding FechaFin, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fecha final"/></StackPanel>
 <StackPanel Grid.Column="4"><TextBlock Text="Tipo de reporte" Style="{StaticResource PanelMuted}" Margin="0,0,0,6"/>
 <ComboBox Style="{StaticResource PanelSelect}" ItemsSource="{Binding TiposReporte}" SelectedItem="{Binding TipoReporteSeleccionado}" AutomationProperties.Name="Tipo de reporte"/></StackPanel>
 <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
 <Button Style="{StaticResource PanelButton}" Command="{Binding GenerarReporteCommand}" Content="Generar · F2" MinWidth="110"/>
 <Button Style="{StaticResource PanelOutlineButton}" Command="{Binding LimpiarFiltrosCommand}" Margin="8,0,0,0" Padding="10" ToolTip="Restablecer filtros" AutomationProperties.Name="Restablecer filtros"><Path Style="{StaticResource PanelIcon}" Data="{StaticResource IconRefresh}" Stroke="#1767D8"/></Button>
 </StackPanel></Grid></Grid></Border>
 <Border Grid.Row="3" Style="{StaticResource PanelCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="320"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding TipoReporteSeleccionado, StringFormat=Detalle de {0}}" Style="{StaticResource PanelTitle}"/>
 <TextBlock Text="{Binding MensajeEstado}" Style="{StaticResource PanelMuted}" AutomationProperties.LiveSetting="Polite" Margin="0,5,0,0"/></StackPanel>
 <Button Grid.Column="2" Style="{StaticResource PanelButton}" Background="#078268" BorderBrush="#078268" Command="{Binding ExportarExcelCommand}" VerticalAlignment="Center">
 <StackPanel Orientation="Horizontal"><Path Style="{StaticResource PanelIcon}" Data="{StaticResource IconDown}" Stroke="White"/><TextBlock Text="Exportar · F4" VerticalAlignment="Center" Margin="9,0,0,0"/></StackPanel></Button></Grid>
 <Border Grid.Row="1" Background="#EDF7F4" BorderBrush="#C9E7DE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
         Visibility="{Binding HayAvisoExportacion, Converter={StaticResource PanelBoolVisibility}}">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="{Binding MensajeExportacion}" Foreground="#155E4B" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
 <TextBlock Text="{Binding UltimoArchivoExportado}" FontSize="12" Foreground="#52657E" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
 <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
 <Button Style="{StaticResource PanelOutlineButton}" Content="Abrir carpeta" Command="{Binding AbrirCarpetaCommand}"/>
 <Button Style="{StaticResource PanelOutlineButton}" Content="Cerrar" Command="{Binding CerrarAvisoExportacionCommand}" Margin="8,0,0,0"/>
 </StackPanel></Grid></Border>
 <Border Grid.Row="2" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="7" ClipToBounds="True"><Grid>
 <DataGrid ItemsSource="{Binding Resultados}" x:Name="TablaVentas" MinHeight="230"><DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource PanelTable}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TipoReporteSeleccionado}" Value="Ventas"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DataGrid.Style><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145"/>
<DataGridTextColumn Header="Ticket" Binding="{Binding Comprobante}" Width="105"/>
<DataGridTextColumn Header="Ítems" Binding="{Binding CantidadProductos}" Width="85" ElementStyle="{StaticResource PanelNumber}"/>
<DataGridTextColumn Header="Subtotal" Binding="{Binding TotalBruto, StringFormat=S/ {0:N2}}" Width="100" ElementStyle="{StaticResource PanelNumber}"/>
<DataGridTextColumn Header="IGV" Binding="{Binding Igv, StringFormat=S/ {0:N2}}" Width="90" ElementStyle="{StaticResource PanelNumber}"/>
<DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=S/ {0:N2}}" Width="105" ElementStyle="{StaticResource PanelNumber}"/>
<DataGridTextColumn Header="Pago" Binding="{Binding MedioPago}" Width="90"/>
<DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="*"/></DataGrid.Columns></DataGrid>
 <DataGrid ItemsSource="{Binding Resultados}" x:Name="TablaAbastecimientos" MinHeight="230"><DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource PanelTable}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TipoReporteSeleccionado}" Value="Abastecimientos"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DataGrid.Style><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145"/>
<DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="*"/>
<DataGridTextColumn Header="Ítems" Binding="{Binding CantidadProductos}" Width="85" ElementStyle="{StaticResource PanelNumber}"/>
<DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=S/ {0:N2}}" Width="100" ElementStyle="{StaticResource PanelNumber}"/>
<DataGridTextColumn Header="IGV" Binding="{Binding Igv, StringFormat=S/ {0:N2}}" Width="90" ElementStyle="{StaticResource PanelNumber}"/>
<DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=S/ {0:N2}}" Width="105" ElementStyle="{StaticResource PanelNumber}"/>
<DataGridTextColumn Header="Pago" Binding="{Binding MedioPago}" Width="95"/></DataGrid.Columns></DataGrid>
 <DataGrid ItemsSource="{Binding Resultados}" x:Name="TablaMovimientosdeCaja" MinHeight="230"><DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource PanelTable}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TipoReporteSeleccionado}" Value="Movimientos de Caja"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DataGrid.Style><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145"/>
<DataGridTemplateColumn Header="Movimiento" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate>
<TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding TipoMovimiento}"/><Style.Triggers>
<DataTrigger Binding="{Binding TipoMovimiento}" Value="IngresoVenta"><Setter Property="Text" Value="Venta"/></DataTrigger>
<DataTrigger Binding="{Binding TipoMovimiento}" Value="EgresoAbastecimiento"><Setter Property="Text" Value="Abastecimiento"/></DataTrigger>
<DataTrigger Binding="{Binding TipoMovimiento}" Value="ReversionVenta"><Setter Property="Text" Value="Anulación de venta"/></DataTrigger>
</Style.Triggers></Style></TextBlock.Style></TextBlock>
</DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
<DataGridTextColumn Header="Pago" Binding="{Binding MedioPago}" Width="90"/>
<DataGridTextColumn Header="Importe" Binding="{Binding Monto, StringFormat=S/ {0:N2}}" Width="105" ElementStyle="{StaticResource PanelNumber}"/>
<DataGridTextColumn Header="Responsable" Binding="{Binding Usuario}" Width="115"/></DataGrid.Columns></DataGrid>
 <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,40,20,0">
 <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Resultados.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
 <Border Width="48" Height="48" Background="#EEF4FC" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,12"><Path Style="{StaticResource PanelIcon}" Data="{StaticResource IconEmpty}" Stroke="#6D87A5"/></Border>
 <TextBlock Text="No hay resultados para mostrar" HorizontalAlignment="Center" Style="{StaticResource PanelTitle}"/>
 <TextBlock Text="Selecciona tus filtros y genera el reporte." HorizontalAlignment="Center" Style="{StaticResource PanelMuted}" Margin="0,7,0,0"/>
 </StackPanel></Grid></Border>
 <Border Grid.Row="3" Background="#F5F8FC" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
 <TextBlock Text="Ventas vigentes y egresos del período. La diferencia corresponde a los cierres de efectivo, no a la utilidad del negocio." Style="{StaticResource PanelMuted}"/>
 </Border></Grid></Border>
 </Grid></ScrollViewer>
</UserControl>

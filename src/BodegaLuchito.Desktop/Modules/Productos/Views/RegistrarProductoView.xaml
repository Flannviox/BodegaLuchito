<UserControl x:Class="BodegaLuchito.Desktop.Modules.Productos.Views.RegistrarProductoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid>
        <!-- ================= CAPA 1: VISTA PRINCIPAL ================= -->
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Gestión de productos" FontSize="28" FontWeight="Bold" Foreground="#17365D" />
                    <TextBlock Text="Administra el catálogo y el inventario del sistema." Margin="0,6,0,0" FontSize="14" Foreground="#64748B"/>
                </StackPanel>
                <Button Content="+ Nuevo producto" 
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Height="42" Padding="20,0"
                        Command="{Binding AbrirModalNuevoCommand}" 
                        Background="#0866E5" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,18,0,0" />

            <Grid Grid.Row="2" Margin="0,18,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="420" Height="44" HorizontalAlignment="Left">
                    <TextBox x:Name="BuscarProductoTextBox" Padding="14,0" VerticalContentAlignment="Center" FontSize="14" 
                             Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="Buscar por nombre, categoría o código..." Margin="15,0,0,0" VerticalAlignment="Center" 
                               Foreground="#94A3B8" FontSize="14" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=BuscarProductoTextBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Editar" Command="{Binding EditarCommand}" 
                            Height="40" Padding="18,0" Margin="0,0,8,0"
                            Background="White" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" 
                            FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Eliminar" Command="{Binding EliminarCommand}" 
                            Height="40" Padding="18,0" 
                            Background="White" Foreground="#EF4444" BorderBrush="#FECACA" BorderThickness="1" 
                            FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
                <DataGrid ItemsSource="{Binding Productos}"
                          SelectedItem="{Binding ProductoSeleccionado, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          RowHeight="46"
                          ColumnHeaderHeight="44">

                    <DataGrid.Resources>
                        <Style x:Key="DataGridTextCellStyle" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="6,0" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="8,0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="6,0" />
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" ElementStyle="{StaticResource DataGridTextCellStyle}" Width="3*" />
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria.Nombre}" ElementStyle="{StaticResource DataGridTextCellStyle}" Width="2*" />
                        <DataGridTextColumn Header="Cód. Barras" Binding="{Binding CodigoBarras}" ElementStyle="{StaticResource DataGridTextCellStyle}" Width="2*" />
                        <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadVenta}" ElementStyle="{StaticResource DataGridTextCellStyle}" Width="1.5*" />
                        <DataGridTextColumn Header="Precio" Binding="{Binding PrecioVenta, StringFormat=S/ \{0:F2\}}" ElementStyle="{StaticResource DataGridTextCellStyle}" Width="1.5*" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockActual}" ElementStyle="{StaticResource DataGridTextCellStyle}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ================= CAPA 2: OVERLAY MODAL PRODUCTO ================= -->
        <Border Background="#990F172A" Visibility="{Binding ModalVisible}">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="34" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">

                <StackPanel>
                    <TextBlock Text="{Binding TituloModal}" FontSize="24" FontWeight="Bold" Foreground="#17365D" Margin="0,0,0,20"/>

                    <TextBlock Text="Nombre" Foreground="#475569" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                    <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Height="44" Margin="0,0,0,12" Padding="12,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="White"/>

                    <TextBlock Text="Categoría" Foreground="#475569" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding CategoriasDisponibles}" 
                                  SelectedItem="{Binding CategoriaSeleccionada}" 
                                  DisplayMemberPath="Nombre"
                                  Height="44" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="White"/>
                        <Button Grid.Column="1" Content="+" Command="{Binding AbrirModalNuevaCategoriaCommand}"
                                Width="44" Height="44" Margin="8,0,0,0"
                                Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="20" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <TextBlock Text="Código de Barras" Foreground="#475569" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                    <TextBox x:Name="TxtCodigoBarras" 
                             PreviewTextInput="TxtCodigoBarras_PreviewTextInput"
                             PreviewKeyDown="TxtCodigoBarras_PreviewKeyDown"
                             KeyDown="TxtCodigoBarras_KeyDown"
                             ContextMenu="{x:Null}"
                             Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}" 
                             Height="44" Margin="0,0,0,12" Padding="12,0" 
                             VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="White"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Precio (S/)" Foreground="#475569" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                            <TextBox x:Name="TxtPrecioVenta" Text="{Binding PrecioVenta, UpdateSourceTrigger=LostFocus}" PreviewTextInput="ValidarSoloNumerosDecimales" Height="44" Padding="12,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="White"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Unidad" Foreground="#475569" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                            <ComboBox ItemsSource="{Binding UnidadesVenta}" SelectedItem="{Binding UnidadVenta}" Height="44" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="White"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Controla Inventario" IsChecked="{Binding ControlaInventario}" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,14" IsEnabled="{Binding ControlaInventario}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Stock Actual " Foreground="#475569" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding SufijoUnidad}" Foreground="#475569" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                            <TextBox Text="{Binding StockActual, UpdateSourceTrigger=LostFocus}" PreviewTextInput="ValidarEntradaStock" Height="44" Padding="12,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="White"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Stock Mínimo " Foreground="#475569" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding SufijoUnidad}" Foreground="#475569" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                            <TextBox Text="{Binding StockMinimo, UpdateSourceTrigger=LostFocus}" PreviewTextInput="ValidarEntradaStock" Height="44" Padding="12,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="White"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                        <Button Content="Cancelar" Command="{Binding CerrarModalCommand}" 
                                Width="100" Height="40" Margin="0,0,10,0"
                                Background="White" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" 
                                FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Guardar" Command="{Binding GuardarCommand}" 
                                Width="110" Height="40" 
                                Background="#0866E5" Foreground="White" BorderThickness="0" 
                                FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= CAPA 3: OVERLAY MODAL NUEVA CATEGORIA ================= -->
        <Border Background="#990F172A" Visibility="{Binding ModalCategoriaVisible}">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="34" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                <StackPanel>
                    <TextBlock Text="Nueva Categoría" FontSize="20" FontWeight="Bold" Foreground="#17365D" Margin="0,0,0,20"/>
                    <TextBlock Text="Nombre de la categoría" Foreground="#475569" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="13"/>
                    <TextBox Text="{Binding NuevaCategoriaNombre, UpdateSourceTrigger=PropertyChanged}" Height="44" Margin="0,0,0,20" Padding="12,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Background="White"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancelar" Command="{Binding CerrarModalCategoriaCommand}" 
                                Width="90" Height="40" Margin="0,0,10,0"
                                Background="White" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" 
                                FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Guardar" Command="{Binding GuardarNuevaCategoriaCommand}" 
                                Width="90" Height="40" 
                                Background="#0866E5" Foreground="White" BorderThickness="0" 
                                FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
